  .pres-notes-panel { background: #123b45; border-color: rgba(226, 242, 238, .13); }
  .notes-label, .notes-next-label { color: #9ac7c1; }
  .notes-text { color: #e2eeeb; }
  .notes-next-title { color: #c5d9d5; }
  .pres-dot { background: rgba(231, 247, 243, .23); }
  .pres-dot.active { background: #79c3b4; }
  .pres-go-input { background: rgba(231, 247, 243, .08); }
  .pres-go-input:focus { border-color: #79c3b4; }
  .pres-shell button:focus-visible, .pres-shell a:focus-visible,
  .pres-shell input:focus-visible, .pres-dot:focus-visible {
    outline: 3px solid #e1a184;
    outline-offset: 3px;
  }
  .pres-exit-btn:hover { background: rgba(189, 91, 60, .2); color: #ffe2d7; border-color: #d9977e; }

  /* Comparison and authorship tables: projection-size type. */
  :global(.thesis-matrix) { font-size: clamp(14px, 1.2vw, 19px); }
  :global(.thesis-matrix th), :global(.thesis-matrix td) { padding: clamp(4px, .8vh, 10px) 14px; }
  :global(.positioning-matrix td) { font-size: 1.3em; line-height: 1; }
  :global(.authorship-matrix) { font-size: clamp(13px, 1.08vw, 17px); }
  :global(.authorship-matrix th), :global(.authorship-matrix td) { padding: clamp(3px, .6vh, 7px) 12px; }
  :global(.thesis-matrix-legend) { font-size: clamp(12px, .95vw, 15px); margin-top: 4px; }
  @media (max-height: 800px) {
    :global(.traceability-matrix > div) { padding: 9px 14px; }
  }

  /* ════════════════════════════════════════════════════════════════════
     Limnímetro — flood-depth art direction.
     Colour is a water-depth ramp (somero → profundo) and encodes position
     along the modelling chain; one crimson is reserved for risk, T(impacto)
     and limitations. Titles use a condensed face, as map lettering does.
     ════════════════════════════════════════════════════════════════════ */
  .pres-shell {
    --paper: #EEF3F1;
    --ink: #13323A;
    --muted: #4A6870;
    --shallow: #A9D2CC;
    --mid: #3F8E93;
    --deep: #0E4A57;
    --risk: #B5334B;
    --risk-pale: #F6E6E9;
    --font-display: "Avenir Next Condensed", "Avenir Next", "Arial Narrow", sans-serif;
    --font-text: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    --font-math: Charter, "Iowan Old Style", Georgia, serif;
    --deck-ink: var(--ink);
    --deck-muted: var(--muted);
    --deck-paper: var(--paper);
    --deck-water: var(--mid);
    --deck-alert: var(--risk);
    font-family: var(--font-text);
  }

  /* ── Type ── */
  .pres-shell .slide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 3.35vw, 58px);
    line-height: 1.02;
    letter-spacing: -.005em;
    color: var(--ink);
  }
  .pres-shell .slide-type-title .slide-main-title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -.01em;
    line-height: .98;
  }
  .pres-shell .slide-subtitle {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: clamp(17px, 1.35vw, 23px);
    color: var(--muted);
    max-width: 62ch;
  }
  .pres-shell .case-result-value,
  .pres-shell .timeline-dot,
  .pres-shell :global(.thesis-matrix) { font-variant-numeric: tabular-nums lining-nums; }

  /* No tracked capitals anywhere on the canvas */
  .pres-shell .case-process-label,
  .pres-shell .pyhydra-role-title,
  .pres-shell .semantic-metric,
  .pres-shell .cover-role {
    text-transform: none;
    letter-spacing: 0;
  }

  /* ── Bullets: a short water-level dash, no boxes ── */
  .pres-shell .slide .slide-bullets li {
    position: relative;
    padding: 6px 0 6px 30px;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    color: var(--ink);
    font-size: clamp(18px, 1.45vw, 24px);
    line-height: 1.35;
  }
  .pres-shell .slide .slide-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(6px + .68em);
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: var(--mid);
  }

  /* ── Visual slides as a map legend ── */
  .pres-shell .visual-normal-body { align-items: center; }
  .pres-shell .semantic-visual {
    flex: 1;
    justify-content: center;
    gap: clamp(26px, 4.5vh, 52px);
    padding: 0;
    --tone: var(--mid);
  }
  .pres-shell .semantic-visual .semantic-items {
    gap: clamp(22px, 2.4vw, 42px);
    grid-auto-rows: auto;
    row-gap: clamp(26px, 4vh, 44px);
  }
  .pres-shell .semantic-visual .semantic-card {
    min-height: 0 !important;
    padding: 18px 6px 0 0;
    background: none !important;
    border: 0 !important;
    border-top: 6px solid var(--tone) !important;
    border-radius: 0 !important;
    box-shadow: none;
    justify-content: flex-start;
  }
  .pres-shell .semantic-visual .semantic-card::after { content: none !important; }
  .pres-shell .semantic-visual .semantic-label {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: clamp(26px, 2.3vw, 40px);
    line-height: 1.12;
    margin-top: 0;
    color: var(--ink);
  }
  .pres-shell .semantic-visual .semantic-detail {
    font-size: clamp(20px, 1.7vw, 29px);
    line-height: 1.38;
    margin-top: 12px;
    color: var(--muted);
  }
  /* Numbers only where the content is a sequence */
  .pres-shell .semantic-visual .semantic-index { display: none; }
  .pres-shell .semantic-visual.flow .semantic-index,
  .pres-shell .semantic-visual.method-map .semantic-index {
    display: inline;
    width: auto;
    height: auto;
    margin-right: 10px;
    padding: 0;
    background: none;
    border-radius: 0;
    color: var(--tone);
    font: 600 1em/1 var(--font-display);
    vertical-align: baseline;
  }
  /* Depth tones: along a chain the water gets deeper */
  .pres-shell .semantic-visual.flow .semantic-items,
  .pres-shell .semantic-visual.method-map .semantic-items { gap: 10px; }
  .pres-shell .semantic-visual.flow .semantic-card,
  .pres-shell .semantic-visual.method-map .semantic-card { padding-right: 18px; }
  .pres-shell .semantic-visual.flow .semantic-card:nth-child(1),
  .pres-shell .semantic-visual.method-map .semantic-card:nth-child(1) { --tone: #8CC2BE; }
  .pres-shell .semantic-visual.flow .semantic-card:nth-child(2),
  .pres-shell .semantic-visual.method-map .semantic-card:nth-child(2) { --tone: #5FA3A4; }
  .pres-shell .semantic-visual.flow .semantic-card:nth-child(3),
  .pres-shell .semantic-visual.method-map .semantic-card:nth-child(3) { --tone: #3F8E93; }
  .pres-shell .semantic-visual.flow .semantic-card:nth-child(4),
  .pres-shell .semantic-visual.method-map .semantic-card:nth-child(4) { --tone: #23697A; }
  .pres-shell .semantic-visual.flow .semantic-card:last-child,
  .pres-shell .semantic-visual.method-map .semantic-card:last-child { --tone: var(--deep); }
  .pres-shell .semantic-visual.flow .semantic-card:nth-child(3):last-child { --tone: var(--deep); }
  .pres-shell .semantic-visual.layers .semantic-card { --tone: var(--shallow); }
  .pres-shell .semantic-visual.layers .semantic-card:nth-child(3) { --tone: var(--deep); }
  .pres-shell .semantic-visual.roadmap .semantic-card { --tone: var(--risk); }
  .pres-shell .semantic-visual.acknowledgements .semantic-card { --tone: var(--shallow); }
  .pres-shell .semantic-visual.problem .semantic-card { --tone: var(--mid); }
  .pres-shell .semantic-visual.evidence:has(.semantic-card:nth-child(4)) .semantic-label { font-family: var(--font-display); font-size: clamp(30px, 2.6vw, 44px); }

  /* The takeaway is the slide's assertion: it leads, the legend supports it */
  .pres-shell .semantic-visual { justify-content: space-evenly; }
  .pres-shell .semantic-visual .semantic-metric {
    order: -1;
    align-self: flex-start;
    max-width: 34ch;
    padding: 0 0 0 22px;
    background: none;
    border: 0;
    border-left: 6px solid var(--deep);
    border-radius: 0;
    color: var(--ink);
    font: 500 clamp(28px, 2.6vw, 46px)/1.18 var(--font-text);
    letter-spacing: -.01em;
    text-align: left;
  }
  .pres-shell .semantic-visual.problem .semantic-metric {
    max-width: none;
    border-left-color: var(--risk);
    font: 600 clamp(40px, 3.8vw, 64px)/1.1 var(--font-math);
  }

  /* ── Index: the six chapters as a sequence ── */
  .index-list {
    counter-reset: chapter;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    gap: clamp(22px, 4vh, 44px) clamp(40px, 5vw, 90px);
    margin: auto 0;
    padding: 0;
    list-style: none;
  }
  .index-item {
    counter-increment: chapter;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 18px;
    align-items: baseline;
  }
  .index-item::before {
    content: counter(chapter);
    grid-row: span 2;
    font: 600 clamp(44px, 4.2vw, 72px)/.9 var(--font-display);
    color: var(--tone, var(--mid));
  }
  .index-item:nth-child(1) { --tone: #8CC2BE; }
  .index-item:nth-child(2) { --tone: #6FADAD; }
  .index-item:nth-child(3) { --tone: #4F999D; }
  .index-item:nth-child(4) { --tone: #3F8E93; }
  .index-item:nth-child(5) { --tone: #23697A; }
  .index-item:nth-child(6) { --tone: var(--deep); }
  .index-title { font: 600 clamp(22px, 1.9vw, 32px)/1.15 var(--font-text); color: var(--ink); }
  .index-desc { font-size: clamp(16px, 1.3vw, 21px); line-height: 1.35; color: var(--muted); margin-top: 4px; }
  .slide-type-index { justify-content: flex-start; }
  .pres-shell .slide-type-index .slide-heading-area { margin-top: clamp(30px, 4.5vh, 52px); }

  /* ── Timeline: years on a single river line ── */
  .pres-shell .timeline-list { position: relative; padding-left: 0; }
  .pres-shell .timeline-item { gap: 26px; }
  .pres-shell .timeline-dot {
    width: clamp(120px, 11vw, 170px);
    min-width: clamp(120px, 11vw, 170px);
    min-height: 0;
    padding: 0 18px 0 0;
    justify-content: flex-end;
    background: none;
    border: 0;
    border-right: 4px solid var(--mid);
    border-radius: 0;
    color: var(--deep);
    font: 600 clamp(20px, 1.7vw, 28px)/1.1 var(--font-display);
  }
  .pres-shell .timeline-text strong { font-weight: 500; font-size: clamp(18px, 1.45vw, 24px); color: var(--ink); }

  /* ── Quote diagram: same legend language ── */
  .pres-shell .quote-node {
    background: none;
    border: 0;
    border-top: 5px solid var(--mid);
    border-radius: 0;
    color: var(--ink);
    font-weight: 600;
  }
  .pres-shell .quote-node.accent { border-top-color: var(--deep); background: none; color: var(--deep); }
  .pres-shell .quote-node.risk { border-top-color: var(--risk); color: var(--risk); }
  .pres-shell .quote-node small { color: var(--muted); font-weight: 400; }
  .pres-shell .quote-arrow { color: var(--mid); }

  /* ── Case slides: results, role and process without boxes ── */
  .pres-shell .case-result {
    background: none;
    border: 0;
    border-top: 3px solid var(--mid);
    border-radius: 0;
    box-shadow: none;
  }
  .pres-shell .slide-split-left .case-result-value { font-family: var(--font-display); font-weight: 600; color: var(--deep); font-size: clamp(22px, 1.8vw, 32px); white-space: nowrap; }
  /* The value column grows to fit its figure, so a value never runs into its label */
  .pres-shell .slide-split-left:has(.case-results) .case-result { grid-template-columns: minmax(max-content, .42fr) minmax(0, 1fr); column-gap: 14px; }
  .pres-shell .slide-split-left .case-result-label { font-weight: 600; color: var(--ink); font-size: clamp(16px, 1.25vw, 21px); }
  .pres-shell .slide-split-left .case-result-implication { color: var(--muted); font-size: clamp(14px, 1.05vw, 18px); }
  .pres-shell .slide-split-left .pyhydra-role-text { font-size: clamp(15px, 1.15vw, 19px); }
  .pres-shell .slide-split-left .pyhydra-role {
    background: none;
    border: 0;
    border-left: 3px solid var(--shallow);
    border-radius: 0;
    padding: 2px 0 2px 14px;
  }
  .pres-shell .slide-split-left .pyhydra-role-title { font-weight: 600; font-size: 13px; color: var(--muted); }
  .pres-shell .slide-split-left .pyhydra-module {
    background: none;
    padding: 0 8px 0 0;
    color: var(--deep);
    font-family: "SF Mono", Menlo, monospace;
  }
  .pres-shell .case-reference { background: none; border-left-color: var(--shallow); color: var(--muted); }
  .pres-shell .case-process-label { font-weight: 600; font-size: 13px; color: var(--muted); }
  .pres-shell .case-process-step {
    background: none;
    border: 0;
    border-top: 4px solid var(--mid);
    border-radius: 0;
    color: var(--ink);
    font-weight: 600;
  }
  .pres-shell .case-process-step:nth-child(1) { border-top-color: #8CC2BE; }
  .pres-shell .case-process-step:nth-child(2) { border-top-color: #5FA3A4; }
  .pres-shell .case-process-step:nth-child(3) { border-top-color: #3F8E93; }
  .pres-shell .case-process-step:nth-child(4) { border-top-color: #23697A; }
  .pres-shell .case-process-step:last-child { border-top-color: var(--deep); }
  .pres-shell .case-process-step:not(:last-child)::after { content: none; }
  .pres-shell .case-thesis-bridge { background: none; border-left-color: var(--deep); color: var(--ink); }

  /* ── Closing ── */
  .pres-shell .closing-takeaway { background: none; border-radius: 0; font-family: var(--font-text); }
  .pres-shell .closing-link { background: none; border: 0; padding: 0 26px 0 0; color: #c9dcd8; font-size: clamp(14px, 1.05vw, 17px); }
  .pres-shell .closing-takeaway { font-weight: 500; font-size: clamp(20px, 1.7vw, 28px); line-height: 1.3; }


  /* Strategy matrix: success criteria are the deepest column, not a risk */
  .pres-shell :global(.traceability-head) { letter-spacing: 0; font-size: clamp(14px, 1.05vw, 17px); font-weight: 700; }
  .pres-shell :global(.traceability-proof) { background: #DCEBE8; }
  .pres-shell :global(.traceability-proof strong) { color: var(--deep); }
  .pres-shell :global(.traceability-goal strong) { color: var(--ink); }

  /* Quote diagram nodes at projection size */
  .pres-shell .quote-node { font-size: clamp(16px, 1.3vw, 22px); padding: 12px 4px 4px 0; }
  .pres-shell .quote-node small { font-size: clamp(13px, 1vw, 16px); }
  .pres-shell .quote-arrow { font-size: clamp(18px, 1.4vw, 24px); }

  /* Cases table at reading size */
  .pres-shell .slide-type-table .pres-table { font-size: clamp(13px, 1.02vw, 17px); line-height: 1.2; }
  .pres-shell .slide-type-table .pres-table th,
  .pres-shell .slide-type-table .pres-table td { padding: clamp(3px, .55vh, 8px) 12px !important; }
  .pres-shell .slide-type-table .pres-table th { color: var(--deep) !important; background: #DCEBE8; font-weight: 700; }

  /* Results outside case slides (e.g. scientific output) */
  .pres-shell .slide-type-normal .case-results {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(18px, 2vw, 36px);
    margin-bottom: clamp(18px, 3vh, 34px);
  }
  .pres-shell .slide-type-normal .case-result { padding: 14px 0 0; }
  .pres-shell .slide-type-normal .case-result-value { font: 600 clamp(30px, 2.7vw, 46px)/1 var(--font-display); color: var(--deep); margin-bottom: 8px; }
  .pres-shell .slide-type-normal .case-result-label { font-weight: 600; font-size: clamp(16px, 1.3vw, 22px); color: var(--ink); }
  .pres-shell .slide-type-normal .case-result-implication { display: block; margin-top: 4px; font-size: clamp(14px, 1.1vw, 18px); color: var(--muted); }

  @media (max-width: 760px) {
    .index-list { grid-template-columns: 1fr; grid-auto-flow: row; grid-template-rows: none; }
  }

  /* Projection floor: secondary text scales with the screen and never drops
     below a size that reads from the back of a room. Earlier rules use
     :has() and ids with high specificity, so sizes here are !important. */
  .pres-shell .slide-route-step { font-size: clamp(13px, 1vw, 19px) !important; }
  .pres-shell .slide-route-number { width: 1.6em !important; height: 1.6em !important; font-size: .8em !important; }
  .pres-shell .slide-block { font-size: clamp(13px, .95vw, 18px) !important; padding: .3em .7em !important; }
  .pres-shell .cover-role { font-size: clamp(13px, .95vw, 18px) !important; }
  /* Cover: one column for roles, air under the title, programme on its own line */
  .pres-shell .cover-person { grid-template-columns: 8em 1fr !important; column-gap: 1em; }
  .pres-shell .slide-type-title[data-idx="0"] .slide-main-title { line-height: 1.04; margin-bottom: clamp(14px, 2vh, 24px); }
  .pres-shell .slide-type-title[data-idx="0"] .slide-main-subtitle { margin-bottom: clamp(16px, 2.6vh, 30px); line-height: 1.4; }
  .pres-shell .cover-footer { flex-wrap: wrap; row-gap: clamp(10px, 1.6vh, 18px); column-gap: clamp(20px, 2.4vw, 40px); }
  .pres-shell .cover-program { flex-basis: 100%; max-width: 46em; }
  .pres-shell .cover-name { font-size: clamp(17px, 1.3vw, 25px) !important; }
  .pres-shell .cover-program { font-size: clamp(13px, .95vw, 18px) !important; }
  .pres-shell .case-process-label { font-size: clamp(14px, 1vw, 19px) !important; }
  .pres-shell .case-process-step { font-size: clamp(13px, .95vw, 18px) !important; padding: 8px 6px !important; }
  .pres-shell .pyhydra-role-title { font-size: clamp(14px, 1vw, 19px) !important; }
  .pres-shell .pyhydra-role-text { font-size: clamp(15px, 1.15vw, 22px) !important; }
  .pres-shell .pyhydra-module { font-size: clamp(13px, .95vw, 18px) !important; }
  .pres-shell .case-reference { font-size: clamp(14px, 1.05vw, 20px) !important; }
  .pres-shell .slide-figure-caption { font-size: clamp(14px, 1.1vw, 20px) !important; }
  .pres-shell .case-result-implication { font-size: clamp(14px, 1.05vw, 20px) !important; }
  .pres-shell .case-thesis-bridge { font-size: clamp(15px, 1.15vw, 21px) !important; }
  .pres-shell .quote-node small { font-size: clamp(14px, 1.1vw, 20px) !important; }
  .pres-shell :global(.gev-equation-caption) { font-size: clamp(15px, 1.1vw, 20px) !important; }
  .pres-shell :global(.traceability-head) { font-size: clamp(14px, 1.1vw, 20px) !important; }
  .pres-shell :global(.traceability-matrix strong) { font-size: clamp(16px, 1.25vw, 23px) !important; }
  .pres-shell :global(.traceability-matrix span) { font-size: clamp(14px, 1.1vw, 20px) !important; }
  .pres-shell :global(.thesis-matrix-legend) { font-size: clamp(13px, 1vw, 18px) !important; }
  .pres-shell .slide-type-table .pres-table { font-size: clamp(13px, 1.02vw, 19px) !important; }
  .pres-shell :global(.authorship-matrix) { font-size: clamp(13px, 1.08vw, 19px) !important; }

  /* Visual slides with an illustration: assertion and legend on the left,
     schematic or figure on the right. */
  .pres-shell .visual-normal-body.has-figure {
    display: grid;
    grid-template-columns: minmax(0, .66fr) minmax(0, 1.34fr);
    gap: clamp(22px, 2.6vw, 48px);
    align-items: center;
    min-height: 0;
  }
  .pres-shell .has-figure .semantic-visual { gap: clamp(14px, 2.4vh, 28px); min-height: 0; }
  .pres-shell .has-figure .semantic-visual .semantic-items {
    grid-template-columns: 1fr !important;
    gap: clamp(8px, 1.5vh, 18px) !important;
    row-gap: clamp(8px, 1.5vh, 18px) !important;
  }
  .pres-shell .has-figure .semantic-visual .semantic-card {
    border-top: 0 !important;
    border-left: 5px solid var(--tone) !important;
    padding: 2px 0 2px 16px !important;
  }
  .pres-shell .has-figure .semantic-visual .semantic-label { font-size: clamp(18px, 1.5vw, 27px); }
  .pres-shell .has-figure .semantic-visual .semantic-detail { font-size: clamp(14px, 1.15vw, 20px); margin-top: 3px; }
  .pres-shell .has-figure .semantic-visual .semantic-metric { font-size: clamp(21px, 1.85vw, 32px); max-width: none; }
  .pres-shell .has-figure .semantic-visual.problem .semantic-metric { font-size: clamp(28px, 2.5vw, 42px); }
  .pres-shell .visual-figure { margin: 0; align-self: stretch; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .pres-shell .visual-figure img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .pres-shell .visual-figure-grid { align-self: stretch; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: clamp(10px, 1.4vw, 20px); }
  .pres-shell .visual-figure-grid figure { margin: 0; min-height: 0; display: flex; flex-direction: column; gap: 6px; }
  .pres-shell .visual-figure-grid img { flex: 1; min-height: 0; width: 100%; object-fit: contain; background: #F8FBFA; border: 1px solid #C6D8D4; }
  .pres-shell .visual-figure-grid figcaption { font-size: clamp(13px, 1vw, 17px); color: var(--muted); }

  /* Quote slides (question, central hypothesis): statement left, schematic
     right, the formal items as a legend underneath. */
  .pres-shell .slide-type-quote:has(.quote-figure) {
    display: grid !important;
