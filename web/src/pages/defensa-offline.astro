    flex-shrink: 0;
  }
  .pres-dot.active { background: #0d9488; width: 20px; border-radius: 3px; }
  .pres-dot:hover { background: rgba(255,255,255,0.2); }

  .pres-go-input {
    width: 48px;
    padding: 4px 8px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    background: rgba(255,255,255,0.04);
    color: #94a3b8;
    font-size: 12px;
    text-align: center;
    font-family: inherit;
    font-variant-numeric: tabular-nums;
  }
  .pres-go-input:focus { outline: none; border-color: rgba(13,148,136,0.5); color: #e2e8f0; }

  .pres-block-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background 0.6s ease;
  }

  /* Table type slide override styling */
  .pres-table-container {
    overflow: hidden;
    width: 100%;
    margin-top: 6px;
    flex: 1;
  }
  .pres-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.15;
    color: #d5dbe5;
    background: rgba(255,255,255,0.01);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    overflow: hidden;
  }
  .slide-type-table .slide-heading-area { margin-bottom: 10px; }
  .slide-type-table .slide-title { font-size: clamp(32px, 3vw, 44px); }
  .slide-type-table .slide-subtitle { font-size: clamp(16px, 1.35vw, 19px); }
  .slide-type-table .case-thesis-bridge {
    padding: 8px 12px;
    margin: 0 0 7px;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.25;
  }
  .slide-type-table .pres-table {
    font-size: clamp(12px, 1vw, 14px);
    line-height: 1.12;
  }
  .slide-type-table .pres-table th,
  .slide-type-table .pres-table td { padding: 5px 8px !important; }
  .pres-table th {
    padding: 7px 9px;
    background: rgba(13,148,136,0.15);
    border-bottom: 1px solid rgba(13,148,136,0.3);
    color: #5eead4;
    font-weight: 700;
  }
  .pres-table td {
    padding: 6px 9px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
