    <!-- Block glow -->
    <div class="pres-block-glow" id="pres-glow"></div>

    <!-- Slide viewport -->
    <div class="slide-viewport" id="slide-viewport">
      {slides.map((slide, idx) => {
        const figSrc = slide.figure ? asset(`/defensa/figures/${slide.figure}`) : null;
        const secondaryFigSrc = slide.secondaryFigure ? asset(`/defensa/figures/${slide.secondaryFigure}`) : null;
        const isTitle = slide.type === 'title';
        const isIndex = slide.type === 'index';
        const isQuote = slide.type === 'quote';
        const isFigure = slide.type === 'figure';
        const isSplit = slide.type === 'split';
        const isTimeline = slide.type === 'timeline';
        const isMatrix = slide.type === 'matrix';
        const isTable = slide.type === 'table';
        const isNormal = !isTitle && !isIndex && !isQuote && !isFigure && !isSplit && !isTimeline && !isMatrix && !isTable;
        const visual = visualSlides[slide.id];

        return (
          <div
            class={`slide slide-id-${String(slide.id).replace('.', '-')} slide-type-${slide.type ?? 'normal'} ${slide.id === 43 ? 'closing-slide' : ''} ${idx === 0 ? 'active' : ''}`}
            data-idx={idx}
            data-block={slide.block}
            data-color={slide.blockColor}
            style={slide.id === 1 || slide.id === 43 ? `--cover-image:url(${asset('/defensa/cover-stochastic-flood.png')})` : undefined}
          >
            {slide.id !== 1 && (
              <div class="slide-route" style={`--route-color:${slide.blockColor}`} aria-label="Recorrido de la defensa">
                {routeStages.map((stage, stageIndex) => (
                  <span class={`slide-route-step ${stageIndex < routeStageFor(slide.block) ? 'past' : ''} ${stageIndex === routeStageFor(slide.block) ? 'current' : ''}`}>
                    <span class="slide-route-number">{stageIndex + 1}</span><span>{stage}</span>
                  </span>
                ))}
              </div>
            )}
            {/* Block badge (all types except title and index) */}
            {!isTitle && !isIndex && (
              <span class="slide-block" style={`background:${slide.blockColor}22; color:${slide.blockColor}; border:1px solid ${slide.blockColor}44`}>
                {slide.block}
              </span>
            )}

            {/* ── TITLE ── */}
            {isTitle && (
              <>
                <span class="slide-block" style={`background:${slide.blockColor}22; color:${slide.blockColor}; border:1px solid ${slide.blockColor}44; margin-bottom:24px`}>
                  {slide.block}
                </span>
                <div class="slide-main-title">{slide.title}</div>
                {slide.subtitle && <div class="slide-main-subtitle">{slide.subtitle}</div>}
                
                {slide.id !== 1 && slide.id !== 43 && slide.bullets?.length ? (
                  <ul class="slide-title-bullets">
                    {slide.bullets.slice(0, 3).map(b => <li>{b}</li>)}
                  </ul>
                ) : null}

                {slide.id === 43 && (
                  <>
                    <div class="closing-takeaway">Una cadena reproducible que convierte incertidumbre climática e hidrológica en evidencia útil para decidir.</div>
                    <div class="closing-metrics">
                      <div class="closing-metric"><strong>14</strong><span>submódulos científicos integrados en pyhydra</span></div>
                      <div class="closing-metric"><strong>9</strong><span>casos de estudio que validan el mismo núcleo</span></div>
                      <div class="closing-metric"><strong>3/3</strong><span>hipótesis verificadas con evidencia operativa</span></div>
                    </div>
                    <div class="closing-links">
                      <span class="closing-link">github.com/navass11/pyhydra</span>
                      <span class="closing-link">github.com/navass11/HYDRA</span>
                      <span class="closing-link">DOI · 10.5281/zenodo.20932555</span>
                    </div>
                  </>
                )}

                {/* Show cover logos on the first slide only */}
                {slide.id === 1 && (
                  <>
                  <div class="cover-identity">
                    <div class="cover-person"><span class="cover-role">Doctorando</span><span class="cover-name">Salvador Navas Fernández</span></div>
                    <div class="cover-person"><span class="cover-role">Director</span><span class="cover-name">Dr. Manuel del Jesus Peñil</span></div>
                    <div class="cover-person"><span class="cover-role">Tutor</span><span class="cover-name">Dr. César Álvarez Díaz</span></div>
                  </div>
                  <div class="cover-footer">
                    <img src={asset('/defensa/figures/logo_uc_escuela_doctorado.png')} style="height:42px;" alt="Universidad de Cantabria" />
                    <img src={asset('/defensa/figures/logo_ihcantabria_actual.png')} style="width:190px; height:auto; object-fit:contain;" alt="IHCantabria · Instituto de Hidráulica Ambiental, Universidad de Cantabria" />
                    <div class="cover-program">Programa de Doctorado en Ingeniería de Costas, Hidrobiología y Gestión · Tesis Doctoral con Mención Industrial · 2026</div>
                  </div>
                  </>
                )}
              </>
            )}

            {/* ── INDEX ── */}
            {isIndex && (
              <div style="padding:0 32px; display:flex; flex-direction:column; height:100%; box-sizing:border-box; width:100%;">
                <span class="slide-block" style={`background:${slide.blockColor}22; color:${slide.blockColor}; border:1px solid ${slide.blockColor}44; align-self:flex-start;`}>
                  {slide.block}
                </span>
                <div class="slide-heading-area" style="margin-top:16px;">
                  <div class="slide-title">{slide.title}</div>
                  {slide.subtitle && <div class="slide-subtitle">{slide.subtitle}</div>}
                </div>
                <div class="index-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; flex:1; overflow-y:auto; margin-top:20px;">
                  {slide.bullets?.map((b, bi) => {
                    const parts = b.split(' — ');
                    const numAndTitle = parts[0] || '';
                    const desc = parts[1] || '';
                    const num = numAndTitle.split('.')[0] || (bi + 1);
                    const title = numAndTitle.substring(numAndTitle.indexOf('.') + 1).trim();
                    
                    const colors = ['#0d9488', '#3b82f6', '#6366f1', '#0891b2', '#10b981', '#f59e0b', '#ef4444'];
                    const col = colors[bi % colors.length];

                    return (
                      <div class="index-card" style="padding:16px 20px; border-radius:12px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); display:flex; gap:16px; align-items:start;">
                        <div style={`width:36px; height:36px; border-radius:10px; background:${col}22; border:1px solid ${col}44; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:800; color:${col}; flex-shrink:0;`}>
                          {num}
                        </div>
                        <div>
                          <div style="font-size:16px; font-weight:700; color:#f1f5f9; margin-bottom:4px;">{title}</div>
                          <div style="font-size:14px; color:#64748b; line-height:1.4;">{desc}</div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

    {/* ── QUOTE ── */}
            {isQuote && (
              <>
                <div class="quote-heading">
                  <div class="slide-title">{slide.title}</div>
                  <div class="quote-text">{slide.script}</div>
                </div>
                <div class="quote-logic" aria-label={slide.id === 7 ? 'Esquema de validación de hipótesis' : 'Esquema de la pregunta de investigación'}>
                  {slide.id === 7 ? (
                    <>
                      <div class="quote-node">Métodos científicos<br/><small>ya disponibles</small></div><div class="quote-arrow">＋</div>
                      <div class="quote-node" style="border-color:#f59e0b;color:#fcd34d">Fragmentación<br/><small>barrera real</small></div><div class="quote-arrow">→</div>
                      <div class="quote-node accent">Arquitectura integrada<br/><small>reproducible</small></div><div class="quote-arrow">→</div>
                      <div class="quote-node">Transferencia<br/><small>9 casos</small></div>
                    </>
                  ) : (
                    <>
                      <div class="quote-node">Datos climáticos<br/><small>+ incertidumbre</small></div><div class="quote-arrow">→</div>
                      <div class="quote-node accent">Cadena automática<br/><small>reproducible</small></div><div class="quote-arrow">→</div>
                      <div class="quote-node">Modelos físicos<br/><small>+ impactos</small></div><div class="quote-arrow">→</div>
                      <div class="quote-node">Proyecto real<br/><small>reproducible</small></div>
                    </>
                  )}
                </div>
                {slide.bullets?.length ? (
                  <ul class="slide-bullets" style="max-width:650px; text-align:left">
                    {slide.bullets.map(b => <li>{b}</li>)}
                  </ul>
                ) : null}
              </>
            )}

            {/* ── TABLE (MATRIX VISUALIZATION) ── */}
            {isTable && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                  {slide.subtitle && <div class="slide-subtitle">{slide.subtitle}</div>}
                </div>
                <div class="case-thesis-bridge">Una cadena reproducible conecta datos, clima, escenarios y modelos físicos hasta la frecuencia del impacto.</div>
                <div class="pres-table-container">
                  <table class="pres-table">
                    <thead>
                      <tr>
                        <th>Caso de Estudio</th>
                        <th>Aplicación principal</th>
                        <th style="text-align:center;">Datos (M1)</th>
                        <th style="text-align:center;">Clima (M2)</th>
                        <th style="text-align:center;">Estocástica (M3)</th>
                        <th style="text-align:center;">Modelado (M4)</th>
                      </tr>
                    </thead>
                    <tbody>
                      {slide.bullets?.map((b, bi) => {
                        const parts = b.split(' → ');
                        const caseName = parts[0] || '';
                        const details = parts[1] || '';
                        const conciseDetails = caseName.includes('Besaya') ? 'Extremos + hidráulica 2D'
                          : caseName.includes('Mallorca') ? 'Downscaling híbrido'
                          : caseName.includes('Calle 30') ? 'Lluvia → HEC-HMS/RAS'
                          : caseName.includes('Valencia') ? 'Extremos bayesianos'
                          : caseName.includes('Tanganica') ? 'CMIP6 + aprendizaje automático'
                          : caseName.includes('Andes') ? 'CMIP5 + modelo VIC'
                          : caseName.includes('Panamá') ? 'Clima + modelado nacional'
                          : caseName.includes('SIMPCCe') ? 'Caudales mínimos + clima'
                          : caseName.includes('IAHR') ? 'IDF frente a estocástico'
                          : details;
                        const check = '✔';
                        const cross = '—';
                        
                        let m1 = cross, m2 = cross, m3 = cross, m4 = cross;
                        if (caseName.includes('Besaya')) { m1=check; m2=check; m3=check; m4=check; }
                        else if (caseName.includes('Calle 30')) { m1=check; m2=check; m3=check; m4=check; }
                        else if (caseName.includes('Mallorca')) { m1=check; m2=check; m3=check; m4=check; }
                        else if (caseName.includes('Valencia') || caseName.includes('DANA')) { m1=check; m2=check; m3=cross; m4=cross; }
                        else if (caseName.includes('Tanganica')) { m1=check; m2=check; m3=cross; m4=check; }
                        else if (caseName.includes('Panamá')) { m1=check; m2=check; m3=cross; m4=check; }
                        else if (caseName.includes('SIMPCCe')) { m1=check; m2=check; m3=cross; m4=check; }
                        else if (caseName.includes('Andes')) { m1=check; m2=check; m3=cross; m4=check; }
                        else if (caseName.includes('IAHR')) { m1=check; m2=check; m3=check; m4=check; }

                        return (
                          <tr style={`background:${bi % 2 === 0 ? 'rgba(255,255,255,0.01)' : 'transparent'}`}>
                            <td style="font-weight:700; color:#f1f5f9;">{caseName}</td>
                            <td style="color:#94a3b8;">{conciseDetails}</td>
                            <td style={`text-align:center; color:${m1==='✔' ? '#10b981' : '#475569'}; font-weight:bold;`}>{m1}</td>
                            <td style={`text-align:center; color:${m2==='✔' ? '#10b981' : '#475569'}; font-weight:bold;`}>{m2}</td>
                            <td style={`text-align:center; color:${m3==='✔' ? '#10b981' : '#475569'}; font-weight:bold;`}>{m3}</td>
                            <td style={`text-align:center; color:${m4==='✔' ? '#10b981' : '#475569'}; font-weight:bold;`}>{m4}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </>
            )}

            {/* ── NORMAL ── */}
            {isNormal && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                  {slide.subtitle && <div class="slide-subtitle">{slide.subtitle}</div>}
                </div>
                {slide.results?.length ? (
                  <div class="case-results" style={`--result-color:${slide.blockColor}`}>
                    {slide.results.map(result => <div class="case-result"><span class="case-result-value">{result.value}</span><span class="case-result-label">{result.label}</span>{result.implication && <span class="case-result-implication">{result.implication}</span>}</div>)}
                  </div>
                ) : null}
                {slide.pyhydraRole && (
                  <div class="pyhydra-role"><div class="pyhydra-role-title">Papel de pyhydra en este caso</div><div class="pyhydra-role-text">{slide.pyhydraRole}</div><div class="pyhydra-modules">{slide.pyhydraModules?.map(module => <span class="pyhydra-module">{module}</span>)}</div></div>
                )}
                {visual ? (
                  <div class="visual-normal-body">
                    <div class={`semantic-visual ${visual.kind}`} style={`--visual-color:${slide.blockColor}`}>
                      <div class="semantic-items">
                        {visual.items.map((item, itemIndex) => (
                          <div class="semantic-card">
                            <span class="semantic-label"><span class="semantic-index">{itemIndex + 1}</span>{item.label}</span>
                            <span class="semantic-detail">{item.detail}</span>
                          </div>
                        ))}
                      </div>
                      {visual.metric && <div class="semantic-metric">{visual.metric}</div>}
                    </div>
                  </div>
                ) : (
                  <>
                    <div class="slide-script" style={`border-color:${slide.blockColor}66`}>{slide.script}</div>
                    {slide.mathBlock && <div style="margin-bottom:16px;" set:html={slide.mathBlock} />}
                    {slide.bullets?.length ? <ul class="slide-bullets">{slide.bullets.map(b => <li>{b}</li>)}</ul> : null}
                  </>
                )}
              </>
            )}

            {/* ── SPLIT ── */}
            {isSplit && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                  {slide.subtitle && <div class="slide-subtitle">{slide.subtitle}</div>}
                </div>
                <div class="slide-split-body">
                  <div class="slide-split-left">
                    <div class="slide-script" style={`border-color:${slide.blockColor}66`}>{slide.script}</div>
                    
                    {/* Math Formulas if present */}
                    {slide.mathBlock && <div style="margin-bottom:12px;" set:html={slide.mathBlock} />}

                    {slide.results?.length ? (
                      <div class="case-results" style={`--result-color:${slide.blockColor}`}>
                        {slide.results.map(result => <div class="case-result"><span class="case-result-value">{result.value}</span><span class="case-result-label">{result.label}</span>{result.implication && <span class="case-result-implication">{result.implication}</span>}</div>)}
                      </div>
                    ) : slide.bullets?.length ? (
                      <ul class="slide-bullets">
                        {slide.bullets.map(b => <li>{b}</li>)}
                      </ul>
                    ) : null}
                    {slide.pyhydraRole && (
                      <div class="pyhydra-role"><div class="pyhydra-role-title">Papel de pyhydra</div><div class="pyhydra-role-text">{slide.pyhydraRole}</div><div class="pyhydra-modules">{slide.pyhydraModules?.map(module => <span class="pyhydra-module">{module}</span>)}</div></div>
                    )}
                  </div>
                  <div class="slide-split-right">
                    {figSrc && (
                      <>
                        <div class={secondaryFigSrc ? 'slide-evidence-pair' : ''}>
                          <figure><img class="slide-figure" src={figSrc} alt={slide.figureCaption ?? ''} loading="lazy" />{slide.figureCaption && <figcaption class="slide-figure-caption">{slide.figureCaption}</figcaption>}</figure>
                          {secondaryFigSrc && <figure><img class="slide-figure" src={secondaryFigSrc} alt={slide.secondaryFigureCaption ?? ''} loading="lazy" />{slide.secondaryFigureCaption && <figcaption class="slide-figure-caption">{slide.secondaryFigureCaption}</figcaption>}</figure>}
                        </div>
                        {slide.caseReference && <div class="case-reference">{slide.caseReference}</div>}
                        {slide.processSteps?.length ? (
                          <>
                            <div class="case-process-label">Proceso metodológico</div>
                            <div class="case-process" style={`--process-color:${slide.blockColor}`}>
                              {slide.processSteps.map(step => <div class="case-process-step">{step}</div>)}
                            </div>
                          </>
                        ) : null}
                      </>
                    )}
                  </div>
                </div>
              </>
            )}

            {/* ── FIGURE ── */}
            {isFigure && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                  {slide.subtitle && <div class="slide-subtitle">{slide.subtitle}</div>}
                </div>
                <div class="slide-figure-full">
                  {figSrc && (
                    <>
                      <img src={figSrc} alt={slide.figureCaption ?? ''} loading="lazy" />
                      {slide.figureCaption && <div class="slide-figure-caption">{slide.figureCaption}</div>}
                      {slide.caseReference && <div class="case-reference">{slide.caseReference}</div>}
                    </>
                  )}
                </div>
              </>
            )}

            {/* ── TIMELINE ── */}
            {isTimeline && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                </div>
                <div class="slide-script" style={`border-color:${slide.blockColor}66`}>{slide.script}</div>
                <ul class="timeline-list">
                  {slide.bullets?.map((b, bi) => {
                    const [year, ...rest] = b.split(' — ');
                    return (
                      <li class="timeline-item">
                        <div class="timeline-dot">{year.trim()}</div>
                        <div class="timeline-text"><strong>{rest.join(' — ')}</strong></div>
                      </li>
                    );
                  })}
                </ul>
              </>
            )}

            {/* ── MATRIX ── */}
            {isMatrix && (
              <>
                <div class="slide-heading-area">
                  <div class="slide-title">{slide.title}</div>
                </div>
                <div class="slide-script" style={`border-color:${slide.blockColor}66`}>{slide.script}</div>
                <div class="matrix-grid">
                  {slide.bullets?.map(b => {
                    const [name, ...rest] = b.split(' → ');
                    return (
                      <div class="matrix-item">
                        <strong>{name.trim()}</strong>
                        {rest.join(' → ')}
                      </div>
                    );
                  })}
                </div>
              </>
            )}
          </div>
        );
      })}
    </div>

    <!-- Notes panel -->
    <div class="pres-notes-panel" id="notes-panel" style="display: none;">
      <span class="notes-label">🎙 Notas del presentador</span>
      <div class="notes-text" id="notes-text">—</div>
      <div class="notes-next">
        <div class="notes-next-label">→ Siguiente</div>
        <div class="notes-next-title" id="notes-next-title">—</div>
      </div>
    </div>
  </div>

  <!-- Bottom nav -->
  <div class="pres-bottombar">
    <button class="pres-nav-btn" id="pres-prev" aria-label="Ir a la diapositiva anterior">← Anterior</button>
    <div class="pres-slide-dots" id="pres-dots"></div>
    <input class="pres-go-input" id="pres-go" type="number" min="1" max={totalSlides} value="1" title="Ir al slide" />
    <button class="pres-nav-btn pres-nav-next" id="pres-next" aria-label="Ir a la diapositiva siguiente">Siguiente →</button>
  </div>
</div>

<script>
  import { slides, totalSlides } from '../data/slides.ts';

  // ── State ──
  let current = 0;
  let elapsed = 0;
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let notesVisible = false;

  // Read-only preview mode: embedded inside the presenter popup's mirror pane.
  // Its own chrome is hidden and it must not clobber the standalone offline-mode
  // progress saved under the same localStorage key.
  const isPreview = new URLSearchParams(window.location.search).get('preview') === '1';
  if (isPreview) {
    document.getElementById('pres-shell')?.classList.add('is-preview');
    document.querySelectorAll('.slide').forEach(slide => slide.classList.remove('active', 'exit-left'));
  }

  // ── Elements ──
  const allSlides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const progressEl = document.getElementById('pres-progress')!;
  const counterEl  = document.getElementById('pres-counter')!;
  const timerEl    = document.getElementById('pres-timer')!;
  const notesText  = document.getElementById('notes-text')!;
  const notesNext  = document.getElementById('notes-next-title')!;
  const notesPanel = document.getElementById('notes-panel')!;
  const dotsEl     = document.getElementById('pres-dots')!;
  const glowEl     = document.getElementById('pres-glow')!;
  const goInput    = document.getElementById('pres-go') as HTMLInputElement;

  window.addEventListener('message', (event) => {
    if (!isPreview || event.data?.type !== 'defensa-preview-slide') return;
    const index = Number(event.data.index);
    if (Number.isInteger(index)) goTo(Math.min(Math.max(0, index), totalSlides - 1));
  });

  // ── Build dots ──
  slides.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.className = 'pres-dot' + (i === 0 ? ' active' : '');
    dot.title = slides[i].title;
    dot.type = 'button';
    dot.setAttribute('aria-label', `Ir a la diapositiva ${i + 1}: ${slides[i].title}`);
    if (i === 0) dot.setAttribute('aria-current', 'step');
    dot.addEventListener('click', () => goTo(i));
    dotsEl.appendChild(dot);
  });

  // ── Timer ──
  function startTimer() {
    if (timerInterval) return;
    timerInterval = setInterval(() => {
      elapsed++;
      const m = Math.floor(elapsed / 60);
      const s = elapsed % 60;
      timerEl.textContent = `⏱ ${m}:${s.toString().padStart(2,'0')}`;
    }, 1000);
  }

  // ── Render ──
  function goTo(idx: number) {
    if (idx < 0 || idx >= totalSlides) return;

    const prev = allSlides[current];
    const next = allSlides[idx];

    if (prev !== next && isPreview) {
      prev?.classList.remove('active', 'exit-left');
    } else if (prev !== next) {
      prev?.classList.remove('active');
      prev?.classList.add('exit-left');
      setTimeout(() => prev?.classList.remove('exit-left'), 400);
    }

    next?.classList.add('active');

    current = idx;
    const slide = slides[idx];

    // Progress
    const pct = ((idx + 1) / totalSlides) * 100;
    progressEl.style.width = `${pct}%`;

    // Counter
    counterEl.textContent = `${idx + 1} / ${totalSlides}`;

    // Go input
    goInput.value = String(idx + 1);

    // Dots
    document.querySelectorAll('.pres-dot').forEach((d, di) => {
      d.classList.toggle('active', di === idx);
      if (di === idx) d.setAttribute('aria-current', 'step');
      else d.removeAttribute('aria-current');
    });

    // Notes
    notesText.textContent = slide.notes ?? '—';
    const nextSlide = slides[idx + 1];
    notesNext.textContent = nextSlide ? `${idx + 2}. ${nextSlide.title}` : 'Fin de la presentación';

    // Glow background
    glowEl.style.background = `radial-gradient(ellipse 70% 50% at 50% 0%, ${slide.blockColor}10 0%, transparent 70%)`;

    // Bullet animation
    const bullets = next?.querySelectorAll<HTMLElement>('.slide-bullets li');
    if (bullets?.length) {
      bullets.forEach((li, i) => {
        li.classList.remove('active-bullet');
        setTimeout(() => li.classList.add('active-bullet'), i * 120 + 200);
      });
    }

    // Save state
    if (!isPreview) localStorage.setItem('defensa-offline-slide', String(idx));
  }

  // ── Navigation ──
  document.getElementById('pres-next')!.addEventListener('click', () => goTo(current + 1));
  document.getElementById('pres-prev')!.addEventListener('click', () => goTo(current - 1));

  // ── Fullscreen (cross-browser: Safari needs the webkit-prefixed API) ──
  function isFullscreen() {
    const d = document as any;
    return !!(d.fullscreenElement || d.webkitFullscreenElement || d.mozFullScreenElement || d.msFullscreenElement);
  }
  function toggleFullscreen() {
    const d = document as any;
    const el = document.documentElement as any;
    if (!isFullscreen()) {
      const request = el.requestFullscreen ?? el.webkitRequestFullscreen ?? el.mozRequestFullScreen ?? el.msRequestFullscreen;
      if (!request) { alert('Este navegador no admite pantalla completa.'); return; }
      const result = request.call(el);
      if (result?.catch) result.catch((err: Error) => alert('No se ha podido activar pantalla completa: ' + err.message));
    } else {
      const exit = d.exitFullscreen ?? d.webkitExitFullscreen ?? d.mozCancelFullScreen ?? d.msExitFullscreen;
      exit?.call(d);
    }
  }
  const btnFullscreenEl = document.getElementById('btn-fullscreen')!;
  function updateFullscreenButton() {
    btnFullscreenEl.textContent = isFullscreen() ? '⤢' : '⛶';
    btnFullscreenEl.title = isFullscreen() ? 'Salir de pantalla completa (F)' : 'Pantalla completa (F)';
  }
  ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange'].forEach((evt) => {
    document.addEventListener(evt, updateFullscreenButton);
  });

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement) return;
    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); goTo(current + 1); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
    if (e.key === 'f' || e.key === 'F') toggleFullscreen();
    if (e.key === 'p' || e.key === 'P') {
      notesVisible = !notesVisible;
      notesPanel.style.display = notesVisible ? '' : 'none';
    }
  });

  goInput.addEventListener('change', () => {
    const n = parseInt(goInput.value) - 1;
    if (!isNaN(n)) goTo(Math.min(Math.max(0, n), totalSlides - 1));
  });

  document.getElementById('btn-toggle-notes')!.addEventListener('click', () => {
    notesVisible = !notesVisible;
    notesPanel.style.display = notesVisible ? '' : 'none';
  });

  btnFullscreenEl.addEventListener('click', toggleFullscreen);

  // ── Restore state ──
  const stored = localStorage.getItem('defensa-offline-slide');
  const urlParams = new URLSearchParams(window.location.search);
  const urlSlide = urlParams.get('slide');
  const initSlide = urlSlide ? parseInt(urlSlide) : (stored ? parseInt(stored) : 0);
  goTo(Math.min(Math.max(0, initSlide), totalSlides - 1));
  startTimer();
</script>

</Layout>
