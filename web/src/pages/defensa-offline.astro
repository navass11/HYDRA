    background: rgba(103, 183, 170, .15);
    border-color: rgba(103, 183, 170, .48);
  }
  .pres-main { background: #0e303a; }
  .slide-viewport {
    background: var(--deck-paper);
    box-shadow: 0 18px 55px rgba(1, 20, 25, .3);
  }
  .slide {
    padding: clamp(24px, 3.4vw, 50px) clamp(28px, 5vw, 72px);
    color: var(--deck-ink);
  }
  .slide-type-normal, .slide-type-split, .slide-type-table,
  .slide-type-quote, .slide-type-figure, .slide-type-timeline,
  .slide-type-matrix, .slide-type-index {
    background: var(--deck-paper);
  }
  .slide-block {
    padding: 4px 10px;
    margin-bottom: 15px;
    border: 1px solid #c4d8d3 !important;
    border-radius: 4px;
    background: #e1eeea !important;
    color: #246c6d !important;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .01em;
    text-transform: none;
  }
  .slide-route { top: 26px; right: clamp(26px, 4vw, 58px); }
  .slide-route-step { color: #789096; }
  .slide-route-step::after { color: #a8bdb9; }
  .slide-route-number { background: #f8fbfa; border-color: #b9ceca; color: #6d8589; }
  .slide-route-step { font-size: clamp(12px, .9vw, 15px); }
  .slide-route-number { width: 24px; height: 24px; font-size: 12px; }
  .slide-route-step.past { color: #567d7b; }
  .slide-route-step.past .slide-route-number {
    color: #287875; background: #deeeea; border-color: #9fcac0;
  }
  .slide-route-step.current { color: var(--deck-water); }
  .slide-route-step.current .slide-route-number {
    color: #fff; background: var(--deck-water); border-color: var(--deck-water);
    box-shadow: 0 0 0 3px #197b8024;
  }
  .slide-title {
    color: var(--deck-ink);
    font-size: clamp(38px, 3.5vw, 54px);
    font-weight: 750;
    letter-spacing: -.035em;
    line-height: 1.08;
  }
  .slide-subtitle {
    max-width: 860px;
    color: var(--deck-muted);
    font-size: clamp(19px, 1.6vw, 24px);
    font-style: normal;
    line-height: 1.4;
  }
  .slide-heading-area { margin-bottom: 20px; }
  .slide-bullets { gap: 10px; }
  .slide-bullets li {
    padding: 10px 16px;
    border: 0;
    border-left: 3px solid #b8ceca;
    border-radius: 0;
    background: transparent;
    color: #264751;
    font-size: clamp(18px, 1.45vw, 22px);
    line-height: 1.34;
  }
  .slide-bullets li.active-bullet {
    border-left-color: var(--deck-water);
    background: #e4efec;
    color: #173b45;
  }
  .slide-type-title:not([data-idx="0"]):not(.closing-slide) {
    background: radial-gradient(ellipse 55% 65% at 78% 30%, #d7e9e5 0, transparent 75%), var(--deck-paper);
