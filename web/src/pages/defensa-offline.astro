    border-left: 8px solid var(--tone);
  }
  .pres-shell .slide-type-index .index-item::before { content: none; }
  .pres-shell .index-icon {
    display: flex; align-items: center; justify-content: center;
    width: clamp(64px, 6.2vw, 112px); height: clamp(64px, 6.2vw, 112px);
