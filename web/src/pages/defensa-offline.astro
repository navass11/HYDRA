  .pres-shell .slide-type-quote:has(.quote-figure) .slide-bullets { grid-column: 1 / -1; grid-row: 3; max-width: none !important; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: clamp(14px, 1.8vw, 32px); margin: 0; }
  .pres-shell .slide-type-quote:has(.quote-figure) .slide-bullets li {
    min-height: 0;
    padding: 10px 0 10px 18px !important;
