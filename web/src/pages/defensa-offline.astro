    font-weight: 700;
    letter-spacing: 0.1em;
    color: #475569;
    text-transform: uppercase;
  }
  .notes-text {
    font-size: 11.5px;
    color: #cbd5e1;
    line-height: 1.6;
    white-space: pre-wrap;
    flex: 1;
  }
  .notes-next {
    border-top: 1px solid rgba(255,255,255,0.04);
    padding-top: 12px;
  }
  .notes-next-label {
    font-size: 10px;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .notes-next-title {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
  }

  /* ── Bottom nav ── */
  .pres-bottombar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    height: 52px;
    background: rgba(15,23,42,0.95);
    border-top: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
  }
  .pres-nav-btn {
    padding: 8px 20px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .pres-nav-btn:hover { background: rgba(13,148,136,0.15); border-color: rgba(13,148,136,0.4); color: #5eead4; }
  .pres-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .pres-nav-next {
    background: rgba(13,148,136,0.1);
    border-color: rgba(13,148,136,0.35);
    color: #5eead4;
  }
  .pres-nav-next:hover { background: rgba(13,148,136,0.22); }

  .pres-slide-dots {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 4px;
    overflow: hidden;
  }
  .pres-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: 0;
    padding: 0;
