    .pres-slide-dots { display: none; }
  }
  /* The live presenter can leave a narrower audience viewport beside its
     notes panel. Keep chapter navigation and the seven-part index readable
     rather than letting them overflow the embedded 16:9 canvas. */
  @media (min-width: 761px) and (max-width: 1200px) {
    .slide-route {
      right: 22px;
      max-width: 54%;
      gap: 4px;
    }
    .slide-route-step:not(.current) { display: none; }
    .slide-route-step.current { font-size: 13px; }
    .slide-route-number { width: 22px; height: 22px; }
    .slide-type-index > div { min-height: 0; padding-inline: 0 !important; }
    .slide-type-index .index-grid {
      min-height: 0;
      gap: 8px !important;
