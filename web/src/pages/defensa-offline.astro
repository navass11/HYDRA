    .slide-type-quote .slide-bullets,
    .slide-id-8 .slide-bullets { grid-template-columns: 1fr; }
    .slide-type-index > div { padding-inline: 0 !important; }
    .slide-type-index .index-grid { grid-template-columns: 1fr !important; gap: 8px !important; }
    .slide-split-body { grid-template-columns: 1fr; gap: 12px; overflow-y: auto; }
    .slide-split-right { max-height: 42vh; }
    .slide-split-right figure { height: auto; }
    .slide-split-right .slide-figure { width: 100%; height: auto; max-height: 34vh; }
    .quote-logic { flex-wrap: wrap; }
