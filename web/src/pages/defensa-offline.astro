  }
  .pres-shell .index-icon svg { width: 52%; height: 52%; }
  .pres-shell .index-text { display: flex; flex-direction: column; min-width: 0; }
  .pres-shell .index-title { counter-increment: none; font-size: clamp(24px, 2.35vw, 42px); }
  .pres-shell .index-title::before { content: counter(chapter) "  "; color: var(--tone); font-family: var(--font-display); font-weight: 600; }
  .pres-shell .index-desc { font-size: clamp(17px, 1.55vw, 27px); margin-top: 8px; }

  /* Keyboard focus on presenter controls */
  .pres-shell button:focus-visible,
  .pres-shell input:focus-visible,
  .pres-shell a:focus-visible { outline: 3px solid var(--shallow); outline-offset: 2px; }

  @media (max-width: 760px) {
    .pres-topbar { gap: 8px; padding-inline: 10px; }
    .pres-topbar-logo { font-size: 12px; }
    .pres-topbar-logo img { width: 23px; height: 23px; }
