// defensa-offline.astro — Standalone offline thesis defense presentation (no internet needed)
import Layout from '../layouts/Layout.astro';
import { slides as mainSlides, backupSlides } from '../data/slides';
const reserve = Astro.props.reserve === true;
const slides = (reserve ? backupSlides : mainSlides).map(slide => ({ ...slide, script: slide.offlineScript ?? slide.script }));
const totalSlides = slides.length;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}${path}`;
const routeStages = ['Introducción','Estado de la técnica','Arquitectura','Metodología','Casos y validación','Conclusiones'];
const routeStageFor = (block: string) => {
  if (['Apertura','Motivación'].includes(block)) return 0;
  if (block === 'Estado del arte') return 1;
  if (block === 'Arquitectura') return 2;
  if (['Bloque de datos','Bloque climático-estadístico','Bloque de modelización','Demo en vivo'].includes(block)) return 3;
  if (['Casos de estudio','Validación'].includes(block)) return 4;
  return 5;
};
// Line icons for the six chapters of the index (one family, 24px grid).
const chapterIcons = [
  '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/><path d="M8.8 8.6a1.9 1.9 0 1 1 2.6 1.8c-.6.3-.9.7-.9 1.3"/><path d="M10.5 13.6v.1"/>',
  '<path d="M4 19V5.5A1.5 1.5 0 0 1 5.5 4H9v15H5.5A1.5 1.5 0 0 0 4 20.5"/><path d="M9 4h4v16H9"/><path d="m14.5 5.2 3.4-.9 3.6 13.6-3.4.9z"/>',
  '<path d="m12 3 9 4.5-9 4.5-9-4.5z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  '<path d="M4 4v16h16"/><path d="M7 16c3-1 5-3 7-6s3.5-4 6-4.5"/><circle cx="9" cy="14.5" r=".9"/><circle cx="13" cy="11.2" r=".9"/><circle cx="17" cy="7.2" r=".9"/>',
  '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  '<circle cx="12" cy="12" r="8.5"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/>',
];
const quoteFigures: Record<number, string> = { 7: 'esq_hipotesis_central.svg', 8: 'esq_pregunta.svg' };
const visualSlides: Record<number, { kind: string; metric?: string; figure?: string; figures?: { src: string; caption: string }[]; items: { label: string; detail: string }[] }> = {
  2: { kind:'flow', metric:'El título describe una arquitectura reproducible, no un único algoritmo', items:[
    {label:'Modelo',detail:'una cadena completa de cálculo'}, {label:'Automático',detail:'reduce tareas manuales frágiles'},
    {label:'Inundación',detail:'calcula la frecuencia sobre el impacto'}, {label:'Estocástica',detail:'propaga múltiples escenarios plausibles'} ] },
  4.6: { kind:'layers', figure:'esq_aporta.svg', metric:'La originalidad está en convertir conocimiento disperso en capacidad operativa', items:[
    {label:'Integración extremo a extremo',detail:'datos → estadística → escenarios → modelos → impacto'},
    {label:'Reproducibilidad sistemática',detail:'fuente, método, configuración y salida quedan trazados'},
    {label:'Transferencia demostrada',detail:'problemas de escala y finalidad distintas'} ] },
  6: { kind:'problem', figure:'esq_tforzante_timpacto.svg', metric:'T(forzante) ≠ T(impacto)', items:[
    {label:'Evento único',detail:'un pico de lluvia no describe todas las avenidas plausibles'},
    {label:'Estado antecedente',detail:'humedad y confluencias cambian la respuesta de la cuenca'},
    {label:'Impacto hidráulico',detail:'la frecuencia se estima tras simular calados y extensión'} ] },
  11: { kind:'layers', figure:'esq_arquitectura_capas.svg', metric:'Un núcleo científico, tres capas que lo hacen transferible', items:[
    {label:'Métodos científicos',detail:'datos, extremos, escenarios y modelos físicos'},
    {label:'Servicios de ejecución',detail:'API y notebooks sobre el mismo núcleo'},
    {label:'Interfaz web',detail:'acceso, documentación y casos navegables'} ] },
  6: { kind:'problem', figure:'esq_tforzante_timpacto.svg', metric:'T(forzante) ≠ T(impacto)', items:[
    {label:'Evento único',detail:'un pico de lluvia no describe todas las avenidas plausibles'},
    {label:'Estado antecedente',detail:'humedad y confluencias cambian la respuesta de la cuenca'},
    {label:'Impacto hidráulico',detail:'la frecuencia se estima después de simular calados y extensión'} ] },
  11: { kind:'layers', figure:'esq_arquitectura_capas.svg', metric:'Un núcleo científico, tres capas que lo hacen transferible', items:[
    {label:'Métodos científicos',detail:'datos, extremos, escenarios y modelos físicos'},
    {label:'Servicios de ejecución',detail:'API y notebooks sobre el mismo núcleo'},
    {label:'Interfaz web',detail:'acceso, documentación y casos navegables'} ] },
  13: { kind:'sources', figure:'esq_fuentes_datos.svg', metric:'Cualquier fuente llega con el mismo formato y su procedencia registrada', items:[
    {label:'Estaciones',detail:'AEMET, Meteostat y OGIMET'}, {label:'Reanálisis',detail:'ERA5, con cobertura global'},
    {label:'Satélite',detail:'GPM y PERSIANN'}, {label:'Ríos y suelo',detail:'GloFAS, GRDC y SoilGrids'},
    {label:'Proyecciones',detail:'CMIP6 con escenarios SSP'} ] },
  17: { kind:'flow', figure:'esq_adaptadores.svg', metric:'Un contrato común conecta motores distintos sin rehacer el núcleo', items:[
    {label:'Preparar',detail:'adaptar entradas al formato del motor'},
    {label:'Ejecutar',detail:'registrar versión, proceso y resultado'},
    {label:'Homogeneizar',detail:'leer salidas en estructuras comunes'},
    {label:'Validar',detail:'comprobar ejecución y plausibilidad física'} ] },
  18: { kind:'tools', figure:'esq_herramientas.svg', metric:'Las herramientas web llaman al mismo núcleo pyhydra que los notebooks', items:[
    {label:'Extremos',detail:'GEV/GPD bayesiana'}, {label:'Dependencia',detail:'cópulas multivariantes'},
    {label:'Espacio',detail:'kriging e interpolación'}, {label:'Diseño',detail:'curvas IDF'},
    {label:'Modelos',detail:'sensibilidad hidráulica'} ] },
  19: { kind:'flow', figure:'shot_herramienta_gev.jpg', metric:'El método descrito se ejecuta desde la plataforma, con su incertidumbre', items:[
    {label:'Datos',detail:'serie demo sintética o CSV identificado'},
    {label:'Máximos anuales',detail:'la GEV se ajusta a máximos por año'},
    {label:'Ajuste MAP',detail:'máximo de la posterior, sin MCMC'},
    {label:'Resultado',detail:'cuantil y bandas aproximadas mediante Fisher'} ] },
  39.5: { kind:'layers', figure:'esq_casos_escala.svg', metric:'Tres casos se reproducen hoy con notebooks; los nueve aportan resultados contrastables', items:[
    {label:'Principio común',detail:'frecuencia estimada sobre el impacto'},
    {label:'Contextos distintos',detail:'escalas, climas y modelos diferentes'},
    {label:'Transferencia',detail:'módulos auditables sin reconstruir la cadena'} ] },
  46: { kind:'flow', figure:'esq_cadena_estocastica.svg', metric:'Los escenarios aportan valor cuando su impacto puede estimarse', items:[
    {label:'Datos',detail:'observaciones y proyecciones climáticas'},
    {label:'Dependencia',detail:'relaciones espaciales y temporales plausibles'},
    {label:'Modelos físicos',detail:'transformar lluvia en caudal y calado'},
    {label:'Decisión',detail:'estimar frecuencia sobre la variable de impacto'} ] },
  32: { kind:'flow', metric:'En Calle 30 la frecuencia se calcula sobre el calado, con HEC-RAS 1D', items:[
    {label:'Lluvia',detail:'eventos multisitio con cópulas'}, {label:'Caudal',detail:'transformación HEC-HMS'},
    {label:'Selección',detail:'subconjunto representativo MaxDiss'}, {label:'Hidráulica',detail:'HEC-RAS 1D'},
    {label:'Reconstrucción',detail:'miles de impactos con k-NN'} ] },
  40: { kind:'evidence', figure:'esq_hipotesis_evidencia.svg', metric:'Las tres hipótesis se sostienen, cada una con el alcance de su evidencia', items:[
    {label:'H1 Automatización',detail:'miles de ejecuciones encadenadas sin intervención manual: viabilidad demostrada'},
    {label:'H2 Modularidad',detail:'los mismos bloques resuelven problemas y escalas diferentes'},
    {label:'H3 Incertidumbre',detail:'caudal estocástico un 30–37 % superior al convencional; bandas en lugar de cifras únicas'} ] },
  47: { kind:'method-map', figure:'esq_responsabilidades.svg', metric:'La procedencia se conserva en cada transformación', items:[
    {label:'Datos',detail:'observar, reunir y controlar fuentes'},
    {label:'Extremos y clima',detail:'caracterizar frecuencia y condiciones'},
    {label:'Escenarios',detail:'generar combinaciones plausibles'},
    {label:'Respuesta física',detail:'simular lluvia, caudal y calado'},
    {label:'Impacto',detail:'estimar frecuencia para decidir'} ] },
  48: { kind:'evidence', figures:[{src:'fig_iahr2022_comparativa_es.svg',caption:'IAHR 2022: caudal estocástico frente a IDF'},{src:'fig_valencia_t100_auditorio.svg',caption:'Valencia: actualización de T100 en Turís'},{src:'besaya_fig04_intermodel_comparison.png',caption:'Besaya: HEC-RAS frente a SFINCS'},{src:'fig_panama_precipitacion.png',caption:'Panamá: precipitación por subcuencas'}], metric:'Cuatro resultados distintos sostenidos por una misma cadena reproducible', items:[
    {label:'+30–37 %',detail:'caudal de diseño estocástico frente al convencional (IAHR 2022)'},
    {label:'+266 %',detail:'actualización de T100 al incorporar la DANA (Valencia)'},
    {label:'1.990',detail:'simulaciones hidráulicas emparejadas (Besaya)'},
    {label:'414',detail:'combinaciones de análisis climático (Panamá)'} ] },
  41: { kind:'layers', figure:'esq_niveles_contribucion.svg', metric:'Lo original es la integración; los métodos de base son conocimiento previo', items:[
    {label:'Base científica',detail:'metodologías preexistentes incorporadas'},
    {label:'Desarrollo',detail:'módulos, adaptadores y pipelines'},
    {label:'Contribución original',detail:'integración, reproducibilidad y transferencia'} ] },
  42: { kind:'roadmap', figure:'esq_limitaciones.svg', metric:'Cada limitación reconocida abre un desarrollo verificable', items:[
    {label:'Series cortas',detail:'incertidumbre explícita en la cola'}, {label:'Motores externos',detail:'adaptadores y versiones registradas'},
    {label:'Estacionariedad',detail:'generación condicionada al clima'}, {label:'Coste',detail:'emuladores + ejecución distribuida'},
    {label:'Datos globales',detail:'control de calidad y trazabilidad'},
    {label:'Validación observacional',detail:'métricas de acierto y ahorro medido'} ] },
  42.5: { kind:'acknowledgements', metric:'A todos, gracias', items:[
    {label:'Mi familia',detail:'el apoyo que sostuvo todo el recorrido'},
    {label:'Manuel del Jesus Peñil',detail:'rigor, confianza y vocación de utilidad'},
    {label:'César Álvarez Díaz',detail:'disponibilidad y generosidad constantes'},
    {label:'IHCantabria',detail:'el entorno humano, científico y técnico de la tesis'},
    {label:'Álvaro Galán',detail:'motivación y ayuda para mejorar el trabajo'} ] },
};
---

<Layout
  title={reserve ? 'Anexos de defensa — HYDRA' : 'Defensa Tesis — HYDRA (Offline)'}
  loadWebFonts={false}
  description="Presentación standalone de la tesis doctoral HYDRA con figuras"
>

<style is:global>
  /* Reset default layout spaces globally */
  body { overflow: hidden !important; background: #020617 !important; margin: 0; padding: 0; }
  header, footer { display: none !important; }
  main { padding: 0 !important; margin: 0 !important; }
  .offline-capture-controls { display:flex; align-items:center; gap:14px; margin:0 0 16px; }
  .offline-step { padding:10px 18px; border:1px solid #93b8b6; border-radius:6px; color:#254b53; background:transparent; font-size:22px; cursor:pointer; }
  .offline-step.selected { background:#285b62; color:white; }
  .offline-step:focus-visible { outline:4px solid #ba7551; outline-offset:3px; }
  .offline-capture-controls span { margin-left:auto; color:#52696e; font-size:20px; }
  .offline-captures { flex:1; min-height:0; }
  .offline-capture { margin:0; height:100%; display:flex; flex-direction:column; align-items:center; gap:10px; }
  .offline-capture[hidden] { display:none; }
  .offline-capture img { flex:1; min-height:0; width:100%; object-fit:contain; }
  .offline-capture figcaption { font-size:22px; color:#385860; text-align:center; }
  .pres-shell .slide-id-55 .slide-subtitle { max-width:none !important; }
  .pres-shell .slide-id-55 .authorship-matrix { font-size:24px !important; line-height:1.3; }
  .pres-shell .slide-id-55 .authorship-matrix th, .pres-shell .slide-id-55 .authorship-matrix td { padding:8px 14px; }
  .pres-shell .slide-id-55 .authorship-matrix th:first-child { width:26%; }
  .pres-shell .slide-id-55 .authorship-matrix th:nth-child(2) { width:14%; }
  .pres-shell .slide-id-55 .thesis-matrix-legend { font-size:20px; }
</style>

<style>
  /* ── Layout ── */
  .pres-shell {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #020617;
    font-family: 'Inter', system-ui, sans-serif;
    color: #e2e8f0;
    overflow: hidden;
    position: relative;
  }

  /* Read-only mirror inside the presenter popup: no chrome of its own */
  .pres-shell.is-preview .pres-topbar,
  .pres-shell.is-preview .pres-bottombar {
    display: none !important;
  }
  .pres-shell.is-preview .slide-viewport {
    width: min(100vw, calc(100vh * 16 / 9));
    height: min(100vh, calc(100vw * 9 / 16));
  }
  .pres-shell.is-preview .slide { transition:none !important; }

  /* ── Top bar ── */
  .pres-topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    height: 48px;
    background: rgba(15,23,42,0.95);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
    z-index: 100;
  }
  .pres-topbar-logo {
    font-size: 14px;
    font-weight: 800;
    color: #5eead4;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pres-topbar-logo img { width: 28px; height: 28px; border-radius: 8px; }
  .pres-progress-wrap {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }
  .pres-progress-fill {
    height: 100%;
    background: linear-gradient(to right, #0d9488, #06b6d4);
    transition: width 0.5s ease;
  }
  .pres-counter {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pres-timer {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pres-topbar-btn {
    width: 32px; height: 32px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    font-size: 14px;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.15s;
  }
  .pres-topbar-btn:hover { background: rgba(255,255,255,0.08); color: #e2e8f0; }
  .pres-topbar-btn.pres-support-btn { width:auto; padding:0 12px; flex-shrink:0; color:#b8e2d9; }
  .pres-exit-btn:hover { background: rgba(239,68,68,0.15); color: #fca5a5; border-color: rgba(239,68,68,0.3); }

  /* ── Main slide area ── */
  .pres-main {
    flex: 1;
    display: flex;
    overflow: hidden;
    position: relative;
    align-items: center;
    justify-content: center;
  }

  /* ── Slide viewport ── */
  .slide-viewport {
    flex: none;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    width: min(100%, calc((100vh - 96px) * 16 / 9));
    height: min(100%, calc(100vw * 9 / 16));
    aspect-ratio: 16 / 9;
    background: #020617;
    box-shadow: 0 18px 70px rgba(0, 0, 0, 0.42);
  }

  /* ── Individual slide ── */
  .slide {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 30px 64px;
    opacity: 0;
    transform: translateX(60px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
    justify-content: center;
    overflow-y: auto;
  }
  .slide.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .slide.exit-left {
    opacity: 0;
    transform: translateX(-60px);
  }
  /* Text-dense layouts anchor to the top: if content is long, the title/lead
     stay put and only the tail scrolls, instead of centering symmetric overflow
     off both edges of the screen. */
  .slide-type-normal,
  .slide-type-split,
  .slide-type-table,
  .slide-type-timeline,
  .slide-type-matrix,
  .slide-type-index,
  .slide-type-figure {
    justify-content: flex-start;
  }

  /* ── Block badge ── */
  .slide-block {
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 99px;
    display: inline-block;
    margin-bottom: 20px;
    align-self: flex-start;
  }
  .slide-route {
    position:absolute;
    top:31px;
    right:64px;
    z-index:4;
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:6px;
    max-width:79%;
    white-space:nowrap;
  }
  .slide-route-step {
    display:flex;
    align-items:center;
    gap:5px;
    color:#526075;
    font-size:clamp(10px,.72vw,13px);
    font-weight:750;
    letter-spacing:.025em;
  }
  .slide-route-step::after { content:'›'; color:#334155; margin-left:2px; }
  .slide-route-step:last-child::after { content:''; margin:0; }
  .slide-route-number {
    width:20px;height:20px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;
    border:1px solid #334155;background:#0b1220;color:#64748b;font-size:10px;font-weight:900;
  }
  .slide-route-step.past { color:#78909f; }
  .slide-route-step.past .slide-route-number { border-color:#0f766e;color:#5eead4;background:#0d948822; }
  .slide-route-step.current { color:var(--route-color); }
  .slide-route-step.current .slide-route-number { border-color:var(--route-color);color:#020617;background:var(--route-color);box-shadow:0 0 0 4px color-mix(in srgb,var(--route-color) 16%,transparent); }

  /* ── Title slide ── */
  .slide-type-title {
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(13,148,136,0.1) 0%, transparent 70%);
  }
  .slide-type-title[data-idx="0"] {
    align-items: flex-start;
    text-align: left;
    justify-content: center;
    padding: 54px 72px;
    background:
      linear-gradient(90deg, rgba(2,6,23,.98) 0%, rgba(2,6,23,.88) 42%, rgba(2,6,23,.24) 72%, rgba(2,6,23,.08) 100%),
      var(--cover-image) center/cover no-repeat;
  }
  .slide-type-title[data-idx="0"] .slide-main-title { max-width: 780px; text-align:left; }
  .slide-type-title[data-idx="0"] .slide-main-subtitle { max-width:720px; text-align:left; color:#cbd5e1; }
  .slide-type-title.closing-slide { align-items:stretch; text-align:left; padding:46px 64px; background:linear-gradient(105deg,rgba(2,6,23,.97),rgba(2,6,23,.72)),var(--cover-image) center/cover no-repeat; }
  .closing-slide .slide-main-title { font-size:clamp(40px,5vw,66px); max-width:850px; margin-bottom:8px; }
  .closing-slide .slide-main-subtitle { max-width:760px; color:#cbd5e1; margin-bottom:22px; }
  .closing-takeaway { max-width:900px; padding:16px 20px; border-left:5px solid #2dd4bf; border-radius:0 14px 14px 0; background:rgba(13,148,136,.12); color:#ecfeff; font-size:clamp(17px,1.8vw,22px); font-weight:750; line-height:1.35; }
  .closing-metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:22px; max-width:900px; }
  .closing-metric { padding:15px 17px; border-radius:13px; background:rgba(15,23,42,.8); border:1px solid rgba(94,234,212,.2); backdrop-filter:blur(8px); }
  .closing-metric strong { display:block; color:#5eead4; font-size:clamp(24px,2.6vw,34px); line-height:1; margin-bottom:7px; }
  .closing-metric span { color:#cbd5e1; font-size:12px; line-height:1.3; }
  .closing-links { display:flex; gap:10px; margin-top:20px; flex-wrap:wrap; }
  .closing-link { padding:8px 12px; border-radius:8px; color:#94a3b8; background:rgba(2,6,23,.72); border:1px solid rgba(255,255,255,.08); font-size:11px; }
  .cover-identity { width:min(510px, 48%); display:flex; flex-direction:column; gap:7px; margin-top:8px; }
  .cover-person { padding:9px 13px; border-radius:9px; background:rgba(15,23,42,.76); border:1px solid rgba(255,255,255,.1); backdrop-filter:blur(10px); display:grid; grid-template-columns:92px 1fr; align-items:center; }
  .cover-role { display:block; color:#5eead4; font-size:11px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; margin-bottom:0; }
  .cover-name { color:#f8fafc; font-size:14px; font-weight:700; line-height:1.25; }
  .cover-footer { display:flex; gap:24px; align-items:center; margin-top:18px; }
  .cover-program { color:#94a3b8; font-size:12px; line-height:1.4; max-width:430px; }
  .slide-type-title .slide-main-title {
    font-size: clamp(38px, 4.6vw, 68px);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .slide-type-title .slide-main-subtitle {
    font-size: clamp(17px, 2vw, 23px);
    color: #94a3b8;
    max-width: 760px;
    line-height: 1.5;
    margin-bottom: 28px;
  }
  .slide-title-bullets {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    text-align: left;
    max-width: 620px;
    padding: 0;
    margin: 0 0 24px 0;
  }
  .slide-title-bullets li {
    font-size: clamp(17px, 1.9vw, 21px);
    color: #cbd5e1;
    list-style: none;
    padding: 10px 16px;
    border-radius: 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
  }

  /* ── Normal / split ── */
  .slide-type-normal,
  .slide-type-split,
  .slide-type-table {
    background: linear-gradient(135deg, #020617 0%, #0a0f1e 100%);
  }

  .slide-heading-area { margin-bottom: 16px; }
  .slide-title {
    font-size: clamp(28px, 3.6vw, 46px);
    font-weight: 800;
    color: #f1f5f9;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .slide-subtitle {
    font-size: clamp(17px, 1.9vw, 22px);
    color: #94a3b8;
    font-style: italic;
  }

  /* ── Script quote ── */
  /* Smaller than .slide-bullets on purpose: bullets are the on-screen takeaway
     for the room, the script is supporting narration the presenter also says
     aloud — keeping it secondary in size is what leaves headroom for bullets
     to stay large without the slide overflowing its fixed-height viewport. */
  .slide-script {
    display: none;
  }

  /* Audience mode is a true 16:9 deck. The spoken script remains available in
     presenter notes, but never competes with the visual message on the canvas. */
  :global(:fullscreen) .pres-topbar,
  :global(:fullscreen) .pres-bottombar,
  :global(:fullscreen) .pres-notes-panel,
  :global(:-webkit-full-screen) .pres-topbar,
  :global(:-webkit-full-screen) .pres-bottombar,
  :global(:-webkit-full-screen) .pres-notes-panel {
    display: none !important;
  }
  :global(:fullscreen) .slide-viewport,
  :global(:-webkit-full-screen) .slide-viewport {
    width: min(100vw, calc(100vh * 16 / 9));
    height: min(100vh, calc(100vw * 9 / 16));
  }

  /* ── Quote type ── */
  .slide-type-quote {
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #020617 0%, #050d1a 100%);
  }
  .quote-text {
    font-size: clamp(19px, 2.25vw, 27px);
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.5;
    text-align: center;
    max-width: 900px;
    margin-bottom: 14px;
    position: relative;
  }
  .quote-text::before {
    content: '"';
    font-size: 80px;
    color: rgba(13,148,136,0.2);
    position: absolute;
    top: -20px;
    left: -20px;
    font-family: Georgia, serif;
    line-height: 1;
  }

  /* ── Bullets ── */
  .slide-bullets {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .slide-bullets li {
    font-size: clamp(17px, 1.9vw, 21px);
    color: #d5dbe5;
    padding: 10px 14px;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    line-height: 1.4;
    transition: background 0.2s;
  }

  @media (max-height: 800px) {
    .slide { padding: 20px 44px; }
    .slide-block { margin-bottom: 10px; }
    .slide-heading-area { margin-bottom: 10px; }
    .slide-title { font-size: clamp(24px, 3vw, 38px); }
    .slide-subtitle { font-size: clamp(14px, 1.5vw, 18px); }
    .slide-bullets { gap: 4px; }
    .slide-bullets li { font-size: clamp(14px, 1.35vw, 17px); padding: 7px 12px; }
    .slide-title-bullets { gap: 6px; margin-bottom: 12px; }
    .slide-title-bullets li { font-size: clamp(14px, 1.45vw, 18px); padding: 7px 12px; }
    .slide-type-title { padding: 14px 44px; }
    .slide-type-title .slide-main-title { font-size: clamp(30px, 3.7vw, 50px); margin-bottom: 10px; }
    .slide-type-title .slide-main-subtitle { font-size: clamp(13px, 1.45vw, 17px); margin-bottom: 14px; }
    .slide-type-title img { max-height: 36px; width: auto; }
    .slide-type-quote .quote-text { font-size: clamp(19px, 2.2vw, 28px); margin-bottom: 16px; }
  }
  .slide-bullets li.active-bullet {
    background: rgba(13,148,136,0.06);
    border-color: rgba(13,148,136,0.2);
    color: #e2e8f0;
  }
  .slide:not(.slide-type-quote) .slide-bullets li:nth-child(n+4) { display:none; }
  .slide.slide-id-2:not(.slide-type-quote) .slide-bullets li:nth-child(4) { display:list-item; }

  .visual-normal-body { display:flex; align-items:center; flex:1; min-height:0; width:100%; }
  .semantic-visual { display:flex; width:100%; flex-direction:column; justify-content:center; gap:18px; min-height:0; padding:22px 4px; }
  .semantic-items { display:grid; gap:16px; align-items:stretch; }
  .semantic-card { position:relative; min-height:102px; padding:18px 20px; border-radius:14px; background:linear-gradient(145deg,rgba(15,23,42,.96),rgba(15,23,42,.78)); border:1px solid color-mix(in srgb,var(--visual-color) 42%,transparent); min-width:0; display:flex; flex-direction:column; justify-content:center; }
  .semantic-label { display:block; color:#f8fafc; font-size:18px; font-weight:850; line-height:1.2; }
  .semantic-detail { display:block; color:#cbd5e1; font-size:16px; line-height:1.35; margin-top:7px; }
  .semantic-index { display:inline-flex; width:25px; height:25px; margin-right:8px; border-radius:7px; align-items:center; justify-content:center; color:var(--visual-color); background:color-mix(in srgb,var(--visual-color) 14%,transparent); font-size:12px; font-weight:900; vertical-align:middle; }
  .semantic-visual.flow .semantic-items { grid-template-columns:repeat(4,1fr); }
  .semantic-visual.flow { overflow:hidden; padding-inline:14px; box-sizing:border-box; }
  .semantic-visual.flow .semantic-card:not(:last-child)::after { content:'→'; position:absolute; right:-12px; top:50%; transform:translateY(-50%); color:var(--visual-color); z-index:3; font-size:17px; }
  .semantic-visual.gap .semantic-items { grid-template-columns:1fr 1fr; }
  .semantic-visual.gap .semantic-card:last-child { grid-column:1/-1; text-align:center; border-color:#f59e0b; background:rgba(245,158,11,.08); }
  .semantic-visual.gap .semantic-card:last-child .semantic-label { color:#fbbf24; }
  .semantic-visual.sources .semantic-items,.semantic-visual.tools .semantic-items { grid-template-columns:1fr 1fr; }
  .semantic-visual.sources .semantic-card:last-child,.semantic-visual.tools .semantic-card:last-child { grid-column:1/-1; }
  .semantic-visual.evidence .semantic-items,.semantic-visual.layers .semantic-items { grid-template-columns:repeat(3,1fr); }
  .semantic-visual.evidence .semantic-card { border-left:5px solid #22c55e; padding-left:17px; }
  .semantic-visual.evidence .semantic-card::after { content:'VERIFICADA ✓'; position:absolute; right:14px; top:14px; color:#4ade80; font-size:12px; font-weight:900; letter-spacing:.07em; }
  .semantic-visual.layers .semantic-card:nth-child(3) { border-color:var(--visual-color); background:color-mix(in srgb,var(--visual-color) 10%,#0f172a); }
  .semantic-visual.roadmap .semantic-items { grid-template-columns:repeat(3,1fr); }
  .semantic-visual.acknowledgements .semantic-items { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .semantic-visual.roadmap .semantic-card::after { content:'→'; position:absolute; right:10px; top:11px; color:var(--visual-color); }
  .semantic-metric { align-self:center; padding:10px 18px; border-radius:99px; color:var(--visual-color); background:#020617; border:1px solid color-mix(in srgb,var(--visual-color) 38%,transparent); font-size:15px; font-weight:900; letter-spacing:.04em; text-transform:uppercase; text-align:center; }
  .case-results { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; width:100%; margin-bottom:12px; }
  .case-result { padding:11px 12px; border-radius:11px; background:linear-gradient(145deg,color-mix(in srgb,var(--result-color) 12%,#0f172a),rgba(15,23,42,.82)); border:1px solid color-mix(in srgb,var(--result-color) 32%,transparent); min-width:0; }
  .case-result-value { display:block; color:var(--result-color); font-size:clamp(20px,2.2vw,29px); font-weight:900; line-height:1; margin-bottom:5px; }
  .case-result-label { display:block; color:#f1f5f9; font-size:14px; font-weight:750; line-height:1.22; }
  .case-result-implication { display:block; color:#cbd5e1; font-size:14px; line-height:1.35; margin-top:6px; }
  .slide-split-left .case-results { grid-template-columns:1fr; gap:8px; margin:0; }
  .slide-split-left .case-result { padding:10px 12px; }
  .slide-split-left .case-result-value { display:inline; font-size:21px; margin-right:7px; }
  .slide-split-left .case-result-label { display:inline; font-size:14px; }
  .slide:has(.case-results) .semantic-visual { min-height:0; }
  .pyhydra-role { padding:9px 11px; border-radius:10px; background:rgba(8,145,178,.08); border:1px solid rgba(34,211,238,.2); margin-bottom:10px; }
  .pyhydra-role-title { color:#67e8f9; font-size:13px; font-weight:900; letter-spacing:.07em; text-transform:uppercase; margin-bottom:5px; }
  .pyhydra-role-text { color:#dbeafe; font-size:16px; line-height:1.4; }
  .pyhydra-modules { display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; }
  .pyhydra-module { padding:5px 8px; border-radius:5px; background:rgba(8,145,178,.12); color:#a5f3fc; font:700 14px/1.2 'JetBrains Mono',monospace; }
  .case-thesis-bridge { padding:10px 14px; margin:0 0 7px; border-radius:10px; background:linear-gradient(90deg,rgba(13,148,136,.14),rgba(59,130,246,.07)); border-left:4px solid #2dd4bf; color:#dffdfa; font-size:14px; font-weight:700; line-height:1.35; }
  .quote-logic { display:flex; align-items:center; justify-content:center; gap:10px; margin:6px 0 18px; }
  .quote-node { padding:13px 18px; min-width:150px; text-align:center; border-radius:12px; background:rgba(15,23,42,.9); border:1px solid rgba(96,165,250,.35); color:#e2e8f0; font-weight:800; font-size:14px; }
  .quote-node small { font-size:12px; color:#cbd5e1; }
  .quote-node.accent { background:rgba(37,99,235,.16); border-color:#60a5fa; color:#bfdbfe; }
  .quote-arrow { color:#60a5fa; font-size:24px; font-weight:900; }

  :global(.traceability-matrix) {
    display:grid;
    grid-template-columns:.88fr 1.35fr 1fr;
    width:100%;
    margin:8px 0 14px;
    border-top:1px solid rgba(129,140,248,.45);
    border-left:1px solid rgba(129,140,248,.22);
  }
  :global(.traceability-matrix > div) {
    min-width:0;
    padding:13px 16px;
    border-right:1px solid rgba(129,140,248,.22);
    border-bottom:1px solid rgba(129,140,248,.22);
  }
  :global(.traceability-head) {
    color:#a5b4fc;
    background:rgba(49,46,129,.2);
    font-size:14px;
    font-weight:900;
    letter-spacing:.08em;
  }
  :global(.traceability-goal) { background:rgba(30,41,59,.72); }
  :global(.traceability-build) { background:rgba(15,45,55,.62); }
  :global(.traceability-proof) { background:rgba(49,35,85,.46); }
  :global(.traceability-matrix strong) {
    display:block;
    color:#f8fafc;
    font-size:17px;
    line-height:1.2;
    margin-bottom:5px;
  }
  :global(.traceability-build strong) { color:#67e8f9; font-size:17px; }
  :global(.traceability-proof strong) { color:#c4b5fd; }
  :global(.traceability-matrix span) { display:block; color:#cbd5e1; font-size:15px; line-height:1.3; }

  /* ── Split layout ── */
  .slide-split-body {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: 32px;
    flex: 1;
    overflow: hidden;
    align-items: stretch;
  }
  .slide-split-left { display: flex; flex-direction: column; gap: 12px; }
  .slide-split-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .slide-evidence-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; width:100%; min-height:0; align-items:center; }
  .slide-evidence-pair figure { margin:0; min-width:0; display:flex; flex-direction:column; align-items:center; }
  .slide-evidence-pair .slide-figure { width:100%; height:auto; max-height:38vh; }
  .slide-evidence-pair .slide-figure-caption { font-size:clamp(12px,1vw,14px); line-height:1.25; color:#b3bdca; }
  .slide-figure {
    max-width: 100%;
    max-height: calc(100vh - 220px);
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .slide-figure-caption {
    font-size: clamp(14px, 1.4vw, 16px);
    color: #94a3b8;
    text-align: center;
    margin-top: 8px;
    font-style: italic;
    max-width: 420px;
  }
  .case-reference {
    width: 100%;
    margin-top: 6px;
    color: #cbd5e1;
    font-size: clamp(13px, 1.2vw, 15px);
    line-height: 1.3;
    text-align: left;
    padding: 7px 10px;
    border-left: 3px solid rgba(245,158,11,.7);
    background: rgba(15,23,42,.72);
    border-radius: 0 7px 7px 0;
  }
  .case-process { width:100%; display:flex; align-items:stretch; gap:4px; margin-top:10px; }
  .case-process-step { position:relative; flex:1 1 0; min-width:0; padding:7px 5px; border-radius:8px; background:color-mix(in srgb,var(--process-color) 13%,#0f172a); border:1px solid color-mix(in srgb,var(--process-color) 34%,transparent); color:#e2e8f0; font-size:10.5px; font-weight:800; line-height:1.16; text-align:center; display:flex; align-items:center; justify-content:center; }
  .case-process-step:not(:last-child)::after { content:'›'; position:absolute; right:-7px; top:50%; transform:translateY(-52%); z-index:2; color:var(--process-color); font-size:19px; font-weight:900; }
  .case-process-label { width:100%; margin-top:5px; color:var(--process-color); font-size:10px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; text-align:left; }

  /* ── Figure type ── */
  .slide-type-figure {
    padding: 32px 48px;
    background: #020617;
  }
  .slide-figure-full {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 0;
  }
  .slide-figure-full img {
    max-height: 100%;
    min-height: 0;
    max-width: 100%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.06);
  }

  /* ── Timeline type ── */
  .slide-type-timeline {
    background: #020617;
  }
  .timeline-list {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 8px;
    flex: 1;
    overflow: hidden;
    padding-right: 8px;
  }
  .timeline-item {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-left: 4px;
  }
  .timeline-dot {
    width: clamp(150px, 16vw, 210px);
    min-width: clamp(150px, 16vw, 210px);
    min-height: 44px;
    height: auto;
    padding: 9px 14px;
    box-sizing: border-box;
    border-radius: 12px;
    background: rgba(13,148,136,0.15);
    border: 2px solid rgba(13,148,136,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(13px, 1.2vw, 16px);
    font-weight: 700;
    color: #5eead4;
    flex-shrink: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: center;
    line-height: 1.2;
  }
  .timeline-text {
    min-width: 0;
    flex: 1;
    font-size: clamp(16px, 1.65vw, 20px);
    color: #cbd5e1;
    padding: 8px 0;
    line-height: 1.25;
  }
  .timeline-text strong { color: #e2e8f0; }

  /* ── Matrix type ── */
  .slide-type-matrix { background: #020617; }
  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    flex: 1;
    overflow-y: auto;
  }
  .matrix-item {
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    font-size: clamp(14px, 1.4vw, 16px);
    color: #b8c1cf;
    line-height: 1.4;
  }
  .matrix-item strong { color: #e2e8f0; display: block; margin-bottom: 4px; }

  /* ── Presenter panel ── */
  .pres-notes-panel {
    width: 280px;
    flex-shrink: 0;
    background: rgba(10,15,30,0.95);
    border-left: 1px solid rgba(255,255,255,0.04);
