  }
  .pres-shell .slide-type-quote:has(.quote-figure) .slide-bullets li::before { content: none; }

  /* Index: six chapter panels that fill the canvas, each with its icon */
  .pres-shell .slide-type-index .index-list {
    flex: 1;
    min-height: 0;
    margin: clamp(14px, 2.4vh, 28px) 0 0;
