    .semantic-card { min-height: 90px; padding: 14px; }
    .semantic-label { font-size: 18px; }
    .semantic-detail { font-size: 15px; }
    .slide-route { display: none; }
    .slide-type-quote {
      display: flex;
      flex-direction: column;
      align-items: stretch;
