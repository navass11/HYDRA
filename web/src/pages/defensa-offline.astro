  }
  .notes-next-title {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
  }

  /* ── Bottom nav ── */
  .pres-bottombar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px;
    height: 52px;
    background: rgba(15,23,42,0.95);
    border-top: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
  }
  .pres-nav-btn {
    padding: 8px 20px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .pres-nav-btn:hover { background: rgba(13,148,136,0.15); border-color: rgba(13,148,136,0.4); color: #5eead4; }
  .pres-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .pres-nav-next {
    background: rgba(13,148,136,0.1);
    border-color: rgba(13,148,136,0.35);
    color: #5eead4;
  }
  .pres-nav-next:hover { background: rgba(13,148,136,0.22); }

  .pres-slide-dots {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 4px;
    overflow: hidden;
  }
  .pres-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .pres-dot.active { background: #0d9488; width: 20px; border-radius: 3px; }
  .pres-dot:hover { background: rgba(255,255,255,0.2); }

  .pres-go-input {
    width: 48px;
    padding: 4px 8px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    background: rgba(255,255,255,0.04);
    color: #94a3b8;
    font-size: 12px;
    text-align: center;
    font-family: inherit;
    font-variant-numeric: tabular-nums;
  }
  .pres-go-input:focus { outline: none; border-color: rgba(13,148,136,0.5); color: #e2e8f0; }

  .pres-block-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background 0.6s ease;
  }

  /* Table type slide override styling */
  .pres-table-container {
    overflow: hidden;
    width: 100%;
    margin-top: 6px;
    flex: 1;
  }
  .pres-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.15;
    color: #d5dbe5;
    background: rgba(255,255,255,0.01);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    overflow: hidden;
  }
  .slide-type-table .slide-heading-area { margin-bottom: 10px; }
  .slide-type-table .slide-title { font-size: clamp(32px, 3vw, 44px); }
  .slide-type-table .slide-subtitle { font-size: clamp(16px, 1.35vw, 19px); }
  .slide-type-table .case-thesis-bridge {
    padding: 8px 12px;
    margin: 0 0 7px;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.25;
  }
  .slide-type-table .pres-table {
    font-size: clamp(12px, 1vw, 14px);
    line-height: 1.12;
  }
  .slide-type-table .pres-table th,
  .slide-type-table .pres-table td { padding: 5px 8px !important; }
  .pres-table th {
    padding: 7px 9px;
    background: rgba(13,148,136,0.15);
    border-bottom: 1px solid rgba(13,148,136,0.3);
    color: #5eead4;
    font-weight: 700;
  }
  .pres-table td {
    padding: 6px 9px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  /* ── Thesis defence art direction: flood-map on cold paper ──
     The cover keeps its deep-water contrast; research slides move to a pale
     plotting surface so maps, hydrographs and model output remain legible. */
  .pres-shell {
    --deck-ink: #173b45;
    --deck-muted: #4e6870;
    --deck-paper: #edf4f2;
    --deck-white: #fbfdfc;
    --deck-water: #197b80;
    --deck-water-pale: #dcebe7;
    --deck-alert: #bd5b3c;
    background: #0e303a;
    color: var(--deck-ink);
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  }
  .pres-topbar, .pres-bottombar {
    background: #103640;
    border-color: rgba(226, 242, 238, .13);
  }
  .pres-topbar-logo { color: #9bd5cb; }
  .pres-topbar-logo img { border-radius: 50%; }
  .pres-progress-wrap { background: rgba(231, 247, 243, .17); }
  .pres-progress-fill { background: #67b7aa; transition-duration: .28s; }
  .pres-counter, .pres-timer { color: #b7cbc9; }
  .pres-topbar-btn, .pres-nav-btn, .pres-go-input {
    border-color: rgba(231, 247, 243, .2);
    color: #e1eeeb;
  }
  .pres-topbar-btn:hover, .pres-nav-btn:hover {
