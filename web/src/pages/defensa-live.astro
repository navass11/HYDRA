  // ── Main Slide Navigation ──
  function goTo(idx: number) {
    if (idx < 0 || idx >= totalSlides) return;
    if (current === idx) return;
    current = idx;
    const slide = slides[idx];

    // If we are in the presenter window, update notes-only presentation layout
    if (isPresenterWindow) {
      if (presWinTimer) startTimer();
      presWinCounter.textContent = `${idx + 1} / ${totalSlides}`;
      
      const nextSlide = slides[idx + 1];
      presWinNextBlock.textContent = nextSlide ? `${nextSlide.block} · ~${nextSlide.estimatedMinutes} min` : 'FIN';
      presWinSpeech.textContent = slide.script;
      presWinNotes.textContent = slide.notes ?? 'Sin anotaciones privadas para esta sección.';
      presWinNextTitle.textContent = nextSlide ? `${idx + 2}. ${nextSlide.title}` : 'Fin de la presentación / Ronda de preguntas';

      presWinPrevBtn.disabled = idx === 0;
      presWinNextBtn.disabled = idx === totalSlides - 1;

      // Sync the audience-view preview iframe inside the presenter popup window
      if (presPreviewIframe) {
        presPreviewIframe.src = `${base.replace(/\/$/, '')}/defensa-offline?slide=${idx}&preview=1`;
      }

      // Persist state
      localStorage.setItem('defensa-live-slide', String(idx));
      return;
    }

    // --- AUDIENCE OR SINGLE SCREEN VIEWER MODE ---
    
    // Topbar updates
    const pct = ((idx + 1) / totalSlides) * 100;
    if (progress) progress.style.width = `${pct}%`;
    if (counter) counter.textContent = `${idx + 1} / ${totalSlides}`;
    if (topBlock) {
      topBlock.textContent = slide.block;
      topBlock.style.background = `${slide.blockColor}22`;
      topBlock.style.color = slide.blockColor;
      topBlock.style.borderColor = `${slide.blockColor}44`;
    }

    // Mode badge: clarify at a glance whether we're browsing the live site or viewing a slide
    const isWebEvidence = !!slide.webMode && !!slide.url;
    const modeText = isWebEvidence
      ? (slide.webMode === 'demo' ? '▶ Demostración guiada' : '◆ Evidencia web')
      : '▣ Relato de la defensa';
    if (modeBadge) {
      modeBadge.textContent = modeText;
      modeBadge.classList.toggle('mode-web', isWebEvidence);
    }
    if (goInput) goInput.value = String(idx + 1);

    // Nav buttons
    if (prevBtn) prevBtn.disabled = idx === 0;
    if (nextBtn) nextBtn.disabled = idx === totalSlides - 1;

    // Panel updates (visible to speaker on presenter screen)
    if (panelTitle) panelTitle.textContent = slide.title;
    if (panelSubtitle) panelSubtitle.textContent = slide.subtitle ?? '';
    if (panelObjective) {
      panelObjective.textContent = presenterObjectiveFor(slide);
    }
    if (panelCue) {
      panelCue.textContent = presenterCueFor(slide);
    }
    if (panelResults && panelResultsWrap) {
      panelResults.innerHTML = '';
      panelResultsWrap.style.display = slide.results?.length ? 'block' : 'none';
      slide.results?.forEach(result => {
        const card = document.createElement('div');
        card.className = 'panel-result';
        const value = document.createElement('strong');
        value.textContent = result.value;
        const label = document.createElement('span');
        label.textContent = result.label;
        card.append(value, label);
        if (result.implication) {
          const implication = document.createElement('small');
          implication.textContent = result.implication;
          card.appendChild(implication);
        }
        panelResults.appendChild(card);
      });
    }
    if (panelPyhydraWrap && panelPyhydraRole && panelPyhydraModules) {
      panelPyhydraWrap.style.display = slide.pyhydraRole ? 'block' : 'none';
      panelPyhydraRole.textContent = slide.pyhydraRole ?? '';
      panelPyhydraModules.innerHTML = '';
      slide.pyhydraModules?.forEach(module => {
        const chip = document.createElement('span');
        chip.textContent = module;
        panelPyhydraModules.appendChild(chip);
      });
    }
    if (panelScriptEl) {
      panelScriptEl.textContent = slide.script;
      panelScriptEl.style.borderColor = slide.blockColor;
    }

    if (panelBullets) {
      panelBullets.innerHTML = '';
      if (slide.bullets?.length) {
        panelBulletsWrap.style.display = 'block';
        slide.bullets.forEach(b => {
          const li = document.createElement('li');
          li.textContent = b;
          panelBullets.appendChild(li);
        });
      } else {
        panelBulletsWrap.style.display = 'none';
      }
    }

    if (panelNotes) panelNotes.textContent = slide.notes ?? '—';

    if (panelLinks && panelLinksWrap) {
      panelLinks.innerHTML = '';
      const links = presenterLinksFor(slide);
      panelLinksWrap.style.display = links.length ? 'block' : 'none';
      links.forEach(link => {
        const anchor = document.createElement('a');
        anchor.className = 'panel-link';
        anchor.href = link.href;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.textContent = link.label;
        panelLinks.appendChild(anchor);
      });
    }

    const nextSlide = slides[idx + 1];
    if (panelNextTitle) panelNextTitle.textContent = nextSlide ? `${idx + 2}. ${nextSlide.title}` : 'Fin de la presentación';
    if (panelNextBlock) panelNextBlock.textContent = nextSlide ? `${nextSlide.block} · ~${nextSlide.estimatedMinutes} min` : '';

    // The web is used only for three deliberate pieces of evidence. A URL may
    // still exist as presenter backup without interrupting the main narrative.
    if (isWebEvidence) {
      slideWrap.classList.remove('active-mode');
      iframeWrap.classList.add('active-mode');
      navigateIframe(slide);
    } else {
      if (iframeWrap) iframeWrap.classList.remove('active-mode');
      slideWrap.classList.add('active-mode');
      slideWrap.style.background = `radial-gradient(ellipse 70% 50% at 50% 0%, ${slide.blockColor}0d 0%, transparent 70%), #020617`;
      audienceSlideFrame.contentWindow?.postMessage({ type: 'defensa-preview-slide', index: idx }, '*');
    }

    // Persist slide state
    localStorage.setItem('defensa-live-slide', String(idx));
  }

  // Helper actions to advance / return
  function next() {
    if (current < totalSlides - 1) {
      goTo(current + 1);
      broadcastChange(current);
    }
  }

  function prev() {
    if (current > 0) {
      goTo(current - 1);
      broadcastChange(current);
    }
  }

  // ── Open Presenter notes in a popup window (OneDrive presenter view style) ──
  function openPresenterNotesWindow() {
    const url = new URL(window.location.href);
    url.searchParams.set('presenter', '1');
    url.searchParams.set('slide', String(current));
    const win = window.open(url.toString(), 'defensa_notes', 'width=1100,height=750,menubar=no,toolbar=no,location=no,status=no');
    if (!win || win.closed || typeof win.closed === 'undefined') {
      alert("El navegador ha bloqueado la ventana emergente de Notas. Por favor, permite las ventanas emergentes (pop-ups) en tu barra de direcciones para poder usar la vista de presentador.");
    }
    return win;
  }

  // ── "Presentar": PowerPoint-style two-window start.
  // Browsers exit fullscreen the instant a popup takes focus, so this window can't be
  // made fullscreen *and* spawn the popup in one step — we clean its chrome instead
  // (projection mode) and leave fullscreen as a manual last step once both windows are
  // dragged to their own screens (button/F key still there for that).
  function startPresenting() {
    if (!projectionMode) setProjectionMode(true);
    const win = openPresenterNotesWindow();
    if (win) win.focus();
  }

  // ── Wire controls and UI interactions ──

  // Navigation events
  if (nextBtn) nextBtn.addEventListener('click', next);
  if (prevBtn) prevBtn.addEventListener('click', prev);
  if (presWinNextBtn) presWinNextBtn.addEventListener('click', next);
  if (presWinPrevBtn) presWinPrevBtn.addEventListener('click', prev);

  // Presenter Notes popups
  const btnNotes = document.getElementById('btn-notes');
  if (btnNotes) btnNotes.addEventListener('click', openPresenterNotesWindow);

  const btnPresent = document.getElementById('btn-present');
  if (btnPresent) btnPresent.addEventListener('click', startPresenting);

  // Projection View Toggles
  const btnProj = document.getElementById('btn-projection');
  if (btnProj) btnProj.addEventListener('click', () => setProjectionMode(!projectionMode));

  // Panel toggles
  const btnPanel = document.getElementById('btn-panel-toggle');
  if (btnPanel) {
    btnPanel.addEventListener('click', () => {
      panelOpen = !panelOpen;
      panel.classList.toggle('collapsed', !panelOpen);
      btnPanel.classList.toggle('active', panelOpen);
      btnPanel.textContent = panelOpen ? 'Ocultar Panel' : 'Mostrar Panel';
      btnPanel.setAttribute('aria-label', panelOpen ? 'Ocultar panel lateral' : 'Mostrar panel lateral');
      btnPanel.setAttribute('aria-expanded', String(panelOpen));
    });
  }

  // ── Fullscreen (cross-browser: Safari needs the webkit-prefixed API) ──
  function isFullscreen() {
    const d = document as any;
    return !!(d.fullscreenElement || d.webkitFullscreenElement || d.mozFullScreenElement || d.msFullscreenElement);
  }
  function toggleFullscreen(): Promise<void> {
    const d = document as any;
    const el = document.documentElement as any;
    if (!isFullscreen()) {
      const request = el.requestFullscreen ?? el.webkitRequestFullscreen ?? el.mozRequestFullScreen ?? el.msRequestFullscreen;
      if (!request) { alert('Este navegador no admite pantalla completa.'); return Promise.resolve(); }
      const result = request.call(el);
      if (result?.then) {
        return result.catch((err: Error) => alert('No se ha podido activar pantalla completa: ' + err.message));
      }
      return Promise.resolve();
    } else {
      const exit = d.exitFullscreen ?? d.webkitExitFullscreen ?? d.mozCancelFullScreen ?? d.msExitFullscreen;
      const result = exit?.call(d);
      return result?.then ? result : Promise.resolve();
    }
  }
  function updateFullscreenButtons() {
    const active = isFullscreen();
    if (btnFullscreen) btnFullscreen.textContent = active ? '⛶ Salir de pantalla completa' : '⛶ Pantalla completa';
    if (btnFullscreen) {
      btnFullscreen.setAttribute('aria-label', active ? 'Salir de pantalla completa' : 'Activar pantalla completa');
      btnFullscreen.setAttribute('aria-pressed', String(active));
    }
  }
  ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange'].forEach((evt) => {
    document.addEventListener(evt, updateFullscreenButtons);
  });

  const btnFullscreen = document.getElementById('btn-fullscreen');
  if (btnFullscreen) btnFullscreen.addEventListener('click', toggleFullscreen);

  const notesToggle = document.getElementById('notes-toggle');
  if (notesToggle) {
    notesToggle.addEventListener('click', () => {
      notesOpen = !notesOpen;
      const body = document.getElementById('panel-notes-body')!;
      body.style.display = notesOpen ? 'block' : 'none';
      notesToggle.textContent = notesOpen
        ? '📝 Notas y preguntas típicas del tribunal ▼'
        : '📝 Notas y preguntas típicas del tribunal ▶';
    });
  }

  if (goInput) {
    goInput.addEventListener('change', () => {
      const n = parseInt(goInput.value) - 1;
      if (!isNaN(n)) {
        goTo(Math.min(Math.max(0, n), totalSlides - 1));
        broadcastChange(current);
      }
    });
  }

  // Keyboard shortcut keys logic
  function handleNavKey(key: string) {
    if (key === 'ArrowRight' || key === ' ') next();
    if (key === 'ArrowLeft') prev();
    if (key === 'n' || key === 'N') {
      if (!isPresenterWindow && btnPanel) {
        panelOpen = !panelOpen;
        panel.classList.toggle('collapsed', !panelOpen);
        btnPanel.classList.toggle('active', panelOpen);
        btnPanel.textContent = panelOpen ? 'Ocultar Panel' : 'Mostrar Panel';
        btnPanel.setAttribute('aria-label', panelOpen ? 'Ocultar panel lateral' : 'Mostrar panel lateral');
        btnPanel.setAttribute('aria-expanded', String(panelOpen));
      }
    }
    if (key === 'm' || key === 'M') {
      if (!isPresenterWindow) setProjectionMode(!projectionMode);
    }
    if (key === 'p' || key === 'P') {
      openPresenterNotesWindow();
    }
    if (key === 'f' || key === 'F') {
      toggleFullscreen();
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement) return;
    if (['ArrowRight', ' ', 'ArrowLeft'].includes(e.key)) e.preventDefault();
    handleNavKey(e.key);
  });

  // Keys forwarded from inside the live-site iframe (see Layout.astro): a keydown
  // there never bubbles to this document on its own, so without this the presenter
  // loses arrow-key/space navigation the moment they click into the embedded site.
  window.addEventListener('message', (e) => {
    if (e.origin !== window.location.origin) return;
    if (!e.data || e.data.type !== 'defensa-key') return;
    handleNavKey(e.data.key);
  });

  // Inject CSS animations in page dynamically
  const anims = document.createElement('style');
  anims.textContent = `
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInLeft {
      from { opacity: 0; transform: translateX(-16px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes fadeInRight {
      from { opacity: 0; transform: translateX(16px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes zoomIn {
      from { opacity: 0; transform: scale(0.97); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  `;
  document.head.appendChild(anims);

  // ── Init state load ──
  const stored = localStorage.getItem('defensa-live-slide');
  const urlSlide = params.get('slide');
  const initIdx = urlSlide ? parseInt(urlSlide) : (stored ? parseInt(stored) : 0);

  goTo(Math.min(Math.max(0, initIdx), totalSlides - 1));
  startTimer();
</script>

</Layout>
