---
// defensa-live.astro — Presentación interactiva de tesis (Online/Live) con sincronización de doble pantalla (Modo Presentador)
import Layout from '../layouts/Layout.astro';
import { slides, totalSlides, totalMinutes } from '../data/slides';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}${path}`;
---

<Layout
  title="Defensa Tesis HYDRA — Presentación"
  loadWebFonts={false}
  description="Presentación interactiva: navega la web de HYDRA alternando con diapositivas"
>

<style is:global>
  /* Reset default layout spaces */
  body { overflow: hidden !important; background: #020617 !important; margin: 0; padding: 0; }
  header, footer { display: none !important; }
  main { padding: 0 !important; margin: 0 !important; }

  /* Audience-only full screen mode overrides — must live in a global block: the
     `.projection-view` class is toggled on <body>, which this page's own scoped
     styles can never reach (body belongs to Layout.astro, not this component). */
  body.projection-view .live-panel { display: none !important; }
  body.projection-view .live-topbar { display: none !important; }
  body.projection-view .live-bottombar { display: none !important; }
  .live-dots-wrap { display:none !important; }
  .live-chapter {
    height:28px;
    padding:0 10px;
    border-radius:7px;
    border:1px solid rgba(255,255,255,.06);
    background:rgba(255,255,255,.025);
    color:#475569;
    font:700 10px/1 Inter,system-ui,sans-serif;
    cursor:pointer;
  }
  .live-chapter.active { background:rgba(13,148,136,.16); border-color:rgba(94,234,212,.28); color:#5eead4; }
  .live-chapter:not(.active) { display:none; }
  body.projection-view .live-shell { background:#0e303a; }
  body.projection-view .live-left-viewport,
  body.projection-view .live-slide-wrap { background:#0e303a; }

  /* Comparison and authorship tables injected through slide.mathBlock. */
  .thesis-matrix { width:100%; border-collapse:collapse; margin:4px 0 6px; font-size:13px; line-height:1.2; color:#cbd5e1; border:1px solid rgba(148,163,184,.25); }
  .thesis-matrix th, .thesis-matrix td { padding:5px 9px; border-bottom:1px solid rgba(148,163,184,.15); text-align:left; }
  .thesis-matrix thead th { color:#5eead4; background:rgba(13,148,136,.15); font-weight:800; }
  .thesis-matrix tbody th { color:#f1f5f9; font-weight:700; }
  .positioning-matrix td, .positioning-matrix thead th:not(:first-child) { text-align:center; }
  .thesis-matrix .tm-hydra { color:#0f172a; background:#5eead4; }
  .thesis-matrix .tm-yes { color:#34d399; font-weight:800; }
  .thesis-matrix .tm-part { color:#fbbf24; font-weight:700; }
  .thesis-matrix .tm-no { color:#64748b; }
  .authorship-matrix { font-size:12px; }
  .thesis-matrix-legend { margin:0; color:#94a3b8; font-size:11px; }
</style>

<style>
  /* ── Shell ── */
  .live-shell {
    height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    background: #020617;
    font-family: 'Inter', system-ui, sans-serif;
    color: #e2e8f0;
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  /* ── Top bar ── */
  .live-topbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 46px;
    background: rgba(10,15,30,0.98);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
    z-index: 10;
  }
  .live-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    color: #5eead4;
    white-space: nowrap;
  }
  .live-logo img { width: 26px; height: 26px; border-radius: 7px; }
  .live-block-badge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 9px;
    border-radius: 99px;
    border: 1px solid;
    white-space: nowrap;
    transition: all 0.3s;
  }
  .live-mode-badge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: 99px;
    white-space: nowrap;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
    background: rgba(99,102,241,0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99,102,241,0.35);
  }
  .live-mode-badge.mode-web {
    background: rgba(13,148,136,0.15);
    color: #5eead4;
    border-color: rgba(13,148,136,0.4);
  }
  .live-progress-wrap {
    flex: 1;
    height: 3px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
    min-width: 60px;
  }
  .live-progress-fill {
    height: 100%;
    background: linear-gradient(to right, #0d9488, #06b6d4);
    transition: width 0.5s ease;
  }
  .live-counter {
    font-size: 12px;
    font-weight: 700;
    color: #d0ddda;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .live-timer {
    font-size: 12px;
    font-weight: 600;
    color: #d0ddda;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .live-topbar-btn {
    height: 30px;
    padding: 0 10px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 7px;
    background: rgba(255,255,255,0.04);
    color: #c2d2cf;
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    transition: all 0.15s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .live-topbar-btn:hover { background: rgba(255,255,255,0.1); color: #e2e8f0; }
  .live-topbar-btn.exit:hover { background: rgba(239,68,68,0.15); color: #fca5a5; }
  .live-topbar-btn-primary {
    background: rgba(13,148,136,0.18);
    border-color: rgba(13,148,136,0.5);
    color: #5eead4;
    font-weight: 700;
  }
  .live-topbar-btn-primary:hover { background: rgba(13,148,136,0.3); color: #99f6e4; }
  .live-topbar-btn.active { color: #5eead4; border-color: rgba(13,148,136,0.3); }

  /* ── Main row ── */
  .live-main {
    flex: 1;
    display: flex;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  /* ── Left content area ── */
  .live-left-viewport {
    flex: 1;
    position: relative;
    min-width: 0;
    background: #0e303a;
    overflow: hidden;
  }

  /* ── Iframe wrap ── */
  .live-iframe-wrap {
    position: absolute;
    inset: 0;
    background: #fff;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }
  .live-iframe-wrap.active-mode {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease;
  }
  .live-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  /* Loading overlay */
  .live-iframe-loading {
    position: absolute;
    inset: 0;
    background: #020617;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .live-iframe-loading.visible { opacity: 1; }
  .live-spinner {
    width: 32px; height: 32px;
    border: 2px solid rgba(13,148,136,0.2);
    border-top-color: #0d9488;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .live-loading-text { font-size: 13px; color: #475569; }

  /* ── Slide wrap (for standalone slides) ── */
  .live-slide-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0e303a;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, background 0.6s ease, visibility 0s linear 0.35s;
  }
  .live-slide-wrap.active-mode {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s ease, background 0.6s ease;
  }
  .live-slide-content {
    flex: 1;
    width: 100%;
    max-width: min(100%, calc(100vh * 16 / 9));
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    overflow: hidden;
  }
  .audience-slide-frame {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    border:0;
    background:#020617;
    pointer-events:none;
  }
  .live-slide-content .slide-live-bullet:nth-child(n+4) { display:none; }

  /* ── Side panel (notes/controls) ── */
  .live-panel {
    width: clamp(360px, 30vw, 450px);
    flex: 0 0 clamp(360px, 30vw, 450px);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg,rgba(8,12,24,.995),rgba(5,9,19,.995));
    border-left: 1px solid rgba(94,234,212,0.12);
    overflow: hidden;
    position: relative;
    inset: auto;
    box-shadow: -12px 0 32px rgba(0,0,0,.3);
    transition: flex-basis 0.28s ease, width 0.28s ease, opacity .2s ease;
    z-index: 8;
  }
  .live-panel.collapsed {
    width: 0;
    flex-basis: 0;
    min-width: 0;
    transform: none;
    opacity: 0;
    border: 0;
    box-shadow: none;
    pointer-events: none;
  }

  .panel-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .panel-scroll::-webkit-scrollbar { width: 4px; }
  .panel-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }

  /* Slide info sections */
  .panel-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #9bb7b2;
    text-transform: none;
    margin-bottom: 6px;
  }
  .panel-title {
    font-size: 18px;
    font-weight: 800;
    color: #f1f5f9;
    line-height: 1.35;
  }
  .panel-subtitle {
    font-size: 12.5px;
    color: #94a3b8;
    font-style: italic;
    margin-top: 3px;
  }
  .panel-script {
    font-size: 14px;
    line-height: 1.65;
    color: #cbd5e1;
    border-left: 3px solid;
    padding: 12px 14px;
    background: rgba(255,255,255,.025);
    border-radius: 0 10px 10px 0;
  }
  .panel-bullets {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .panel-bullets li {
    font-size: 13px;
    color: #b8c1cf;
    padding: 8px 10px;
    border-radius: 7px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    line-height: 1.4;
  }
  .panel-notes {
    font-size: 12.5px;
    color: #38bdf8;
    line-height: 1.6;
    white-space: pre-wrap;
    padding: 14px;
    border-radius: 8px;
    background: rgba(14,165,233,0.06);
    border: 1px solid rgba(14,165,233,0.15);
  }
  .panel-brief { display:grid; grid-template-columns:1fr 1fr; gap:9px; }
  .panel-brief-card { padding:11px 12px; border-radius:10px; background:rgba(15,23,42,.72); border:1px solid rgba(255,255,255,.07); }
  .panel-brief-card strong { display:block; color:#5eead4; font-size:9px; letter-spacing:.09em; text-transform:uppercase; margin-bottom:5px; }
  .panel-brief-card span { display:block; color:#cbd5e1; font-size:12px; line-height:1.4; }
  .panel-links { display:flex; flex-direction:column; gap:7px; }
  .panel-link { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 11px; border-radius:9px; background:rgba(13,148,136,.07); border:1px solid rgba(45,212,191,.16); color:#99f6e4; text-decoration:none; font-size:11.5px; line-height:1.3; }
  .panel-link:hover { background:rgba(13,148,136,.14); border-color:rgba(45,212,191,.35); }
  .panel-link::after { content:'↗'; color:#5eead4; flex-shrink:0; }
  .panel-results { display:grid; grid-template-columns:1fr; gap:7px; }
  .panel-result { padding:10px 11px; border-radius:9px; background:rgba(245,158,11,.06); border:1px solid rgba(245,158,11,.18); }
  .panel-result strong { color:#fbbf24; font-size:18px; font-weight:900; margin-right:7px; }
  .panel-result span { color:#e2e8f0; font-size:11.5px; font-weight:700; }
  .panel-result small { display:block; color:#94a3b8; font-size:10.5px; line-height:1.35; margin-top:4px; }
  .panel-pyhydra { padding:12px; border-radius:10px; background:rgba(8,145,178,.08); border:1px solid rgba(34,211,238,.2); color:#dbeafe; font-size:12px; line-height:1.45; }
  .panel-pyhydra-modules { display:flex; flex-wrap:wrap; gap:5px; margin-top:8px; }
  .panel-pyhydra-modules span { padding:3px 6px; border-radius:5px; background:rgba(8,145,178,.14); color:#a5f3fc; font:700 9px/1.2 monospace; }

  /* Divider */
  .panel-divider {
    height: 1px;
    background: rgba(255,255,255,0.04);
  }

  /* Next slide preview */
  .panel-next {
    padding: 10px;
    border-radius: 8px;
    background: rgba(13,148,136,0.05);
    border: 1px solid rgba(13,148,136,0.12);
  }
  .panel-next-label {
    font-size: 10px;
    font-weight: 700;
    color: #9bd5cb;
    letter-spacing: 0.02em;
    text-transform: none;
    margin-bottom: 6px;
  }
  .panel-next-title {
    font-size: 12px;
    font-weight: 600;
    color: #5eead4;
  }
  .panel-next-block {
    font-size: 10px;
    color: #9bb7b2;
    margin-top: 3px;
  }

  /* Notes toggle */
  .notes-toggle-btn {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    text-align: left;
  }
  .notes-toggle-btn:hover { color: #64748b; }

  /* ── Bottom bar ── */
  .live-bottombar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 50px;
    background: rgba(10,15,30,0.98);
    border-top: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
  }
  .live-nav-btn {
    padding: 7px 16px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9px;
    background: rgba(255,255,255,0.04);
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    white-space: nowrap;
  }
  .live-nav-btn:hover { background: rgba(13,148,136,0.15); border-color: rgba(13,148,136,0.4); color: #5eead4; }
  .live-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .live-nav-next {
    background: rgba(13,148,136,0.1);
    border-color: rgba(13,148,136,0.35);
    color: #5eead4;
  }
  .live-nav-next:hover { background: rgba(13,148,136,0.22); }

  .live-dots-wrap {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 5px;
    overflow: hidden;
  }
  .live-chapter {
    height: 28px;
    padding: 0 10px;
    border-radius: 7px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.025);
    color: #475569;
    font: 700 10px/1 inherit;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .live-chapter.active { background: rgba(13,148,136,.16); border-color:rgba(94,234,212,.28); color:#5eead4; }
  .live-chapter:hover:not(.active) { background:rgba(255,255,255,.07); color:#94a3b8; }
  .live-chapter:not(.active) { display:none; }

  .live-go-input {
    width: 46px;
    padding: 4px 6px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    background: rgba(255,255,255,0.03);
    color: #64748b;
    font-size: 12px;
    text-align: center;
    font-family: inherit;
    font-variant-numeric: tabular-nums;
  }
  .live-go-input:focus { outline: none; border-color: rgba(13,148,136,0.5); color: #e2e8f0; }

  /* Keyboard shortcut hint */
  .live-keys {
    font-size: 10px;
    color: #a9bfbb;
    white-space: nowrap;
  }
  @media (max-width: 1450px) {
    .live-keys { display: none; }
    .live-chapter { padding-inline: 8px; font-size: 9px; }
  }

  /* Keep the control rail inside laptop-width viewports. Controls keep their
     accessible names/titles while the visible chrome collapses to clear icons. */
  @media (max-width: 1600px) {
    .live-topbar { gap: 7px; padding-inline: 10px; }
    .live-logo { gap: 6px; font-size: 11px; }
    .live-logo img { width: 23px; height: 23px; }
    .live-block-badge, .live-mode-badge {
      max-width: 130px;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 10px;
      letter-spacing: 0;
      padding: 3px 7px;
    }
    .live-topbar-btn:not(.live-topbar-btn-primary) {
      width: 34px;
      min-width: 34px;
      padding: 0;
      justify-content: center;
      font-size: 0;
      gap: 0;
    }
    .live-topbar-btn:not(.live-topbar-btn-primary)::before {
      font-size: 15px;
      line-height: 1;
    }
    #btn-panel-toggle::before { content: '▤'; }
    #btn-projection::before { content: '◉'; }
    #btn-notes::before { content: 'P'; font-weight: 800; }
    #btn-fullscreen::before { content: '⛶'; font-size: 17px; }
    .live-topbar-btn.exit::before { content: '×'; font-size: 20px; }
    .live-topbar-btn-primary { padding-inline: 9px; font-size: 11px; }
    .live-progress-wrap { min-width: 36px; }
    .live-counter, .live-timer { font-size: 11px; }
  }

  @media (max-width: 1050px) {
    .live-mode-badge { display: none; }
    .live-logo { font-size: 0; }
    .live-panel { width: min(320px, 38vw); flex-basis: min(320px, 38vw); }
    .live-panel.collapsed { width: 0; flex-basis: 0; }
    #btn-present { width: 34px; min-width: 34px; padding: 0; font-size: 0; justify-content: center; }
    #btn-present::before { content: '▶'; font-size: 13px; }
  }

  .live-shell button:focus-visible, .live-shell a:focus-visible,
  .live-shell input:focus-visible {
    outline: 3px solid #e1a184;
    outline-offset: 2px;
  }

  /* Floating audience tool tab (hidden unless hovered) */
  .live-floating-controls {
    position: fixed;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(2, 8, 23, 0.85);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 30px;
    padding: 4px 12px;
    z-index: 10000;
    opacity: 0.1;
    transition: opacity 0.3s;
  }
  .live-floating-controls:hover { opacity: 1; }
  .floating-btn {
    border: none;
    background: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 13px;
    padding: 2px 6px;
    font-family: inherit;
  }
  .floating-btn:hover { color: #5eead4; }

  /* ── PRESENTER WINDOW ONLY MODE OVERRIDES (opened via pop-up) ── */
  .presenter-window-layout {
    display: grid !important;
    grid-template-columns: 1.1fr 0.9fr;
    height: 100vh;
    width: 100vw;
    background: #090d16;
    overflow: hidden;
  }
  .presenter-window-left {
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(255,255,255,0.06);
    background: #020617;
    overflow: hidden;
  }
  .presenter-window-right {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 24px;
    gap: 20px;
  }
  .presenter-preview-frame {
    flex: 1;
    position: relative;
    border: 8px solid #1e293b;
    border-radius: 12px;
    margin: 16px;
    background: #000;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
    overflow: hidden;
  }
  .presenter-notes-area {
    font-size: 15px;
    line-height: 1.6;
    color: #e2e8f0;
    background: rgba(14,165,233,0.05);
    border: 1px solid rgba(14,165,233,0.15);
    border-radius: 10px;
    padding: 16px;
    white-space: pre-wrap;
  }
  .presenter-large-timer {
    font-size: 32px;
    font-weight: 800;
    color: #5eead4;
    font-variant-numeric: tabular-nums;
  }
</style>

<!-- Full-screen shell -->
<div class="live-shell" id="live-shell">

  <!-- Top bar (hidden in projection mode) -->
  <div class="live-topbar" id="live-topbar">
    <div class="live-logo">
      <img src={asset('/favicon.png')} alt="HYDRA" />
      HYDRA · Defensa
    </div>
    <a class="live-topbar-btn" href={asset('/defensa-anexos')} target="_blank">Anexos</a><a class="live-topbar-btn" href={asset('/defensa-respaldo')} target="_blank">Respaldo</a>
    <span class="live-block-badge" id="top-block">Apertura</span>
    <span class="live-mode-badge" id="live-mode-badge">📄 Diapositiva</span>
    <div class="live-progress-wrap">
      <div class="live-progress-fill" id="live-progress" style="width:3.45%"></div>
    </div>
    <span class="live-counter" id="live-counter" aria-live="polite">1 / {totalSlides}</span>
    <span class="live-timer" id="live-timer">⏱ 0:00</span>
    <button class="live-topbar-btn live-topbar-btn-primary" id="btn-present" title="Abre la vista de presentador en otra ventana y pone esta pantalla en modo proyección" aria-label="Abrir vista de presentador">🎬 Presentar</button>
    <button class="live-topbar-btn" id="btn-panel-toggle" title="Mostrar u ocultar el panel lateral (N)" aria-label="Mostrar panel lateral" aria-expanded="false">Mostrar Panel</button>
    <button class="live-topbar-btn active" id="btn-projection" title="Activar o desactivar proyección (M)" aria-label="Activar modo proyección" aria-keyshortcuts="M" aria-pressed="false">📺 Proyectar (M)</button>
    <button class="live-topbar-btn" id="btn-notes" title="Abrir notas en otra pantalla (P)" aria-label="Abrir vista de presentador">📝 Presentador (P)</button>
    <button class="live-topbar-btn" id="btn-fullscreen" title="Pantalla completa (F)" aria-label="Activar pantalla completa" aria-pressed="false">⛶ Pantalla completa</button>
    <a href={asset('/defensa')} class="live-topbar-btn exit" title="Volver" aria-label="Volver a la pantalla de inicio">✕ Salir</a>
  </div>

  <!-- Main view row -->
  <div class="live-main">

    <!-- Left viewport: dynamically toggles between iframe and slide contents -->
    <div class="live-left-viewport">
      
      <!-- Iframe mode wrapper -->
      <div class="live-iframe-wrap" id="iframe-wrap">
        <div class="live-iframe-loading" id="iframe-loading">
          <div class="live-spinner"></div>
          <div class="live-loading-text" id="iframe-loading-text">Cargando HYDRA…</div>
        </div>
        <iframe
          id="live-iframe"
          class="live-iframe"
          src={asset('/')}
          title="HYDRA Web"
          allow="fullscreen"
        ></iframe>
      </div>

      <!-- Slide deck mode wrapper -->
      <div class="live-slide-wrap" id="slide-wrap">
        <iframe
          class="audience-slide-frame"
          id="audience-slide-frame"
          src={asset('/defensa-offline/?slide=0&preview=1')}
          title="Diapositiva proyectada"
          tabindex="-1"
        ></iframe>
        <div class="live-slide-content" id="live-slide-content" style="display:none"></div>
      </div>

    </div>

    <!-- Right Side panel (hidden in projection mode) -->
    <div class="live-panel collapsed" id="live-panel" aria-label="Panel de apoyo al presentador">
      <div class="panel-scroll" id="panel-scroll">

        <!-- Slide title -->
        <div>
          <div class="panel-section-label">Slide actual</div>
          <div class="panel-title" id="panel-title">HYDRA</div>
          <div class="panel-subtitle" id="panel-subtitle"></div>
        </div>

        <div class="panel-brief">
          <div class="panel-brief-card"><strong>Objetivo</strong><span id="panel-objective">—</span></div>
          <div class="panel-brief-card"><strong>Qué señalar</strong><span id="panel-cue">—</span></div>
        </div>

        <div id="panel-results-wrap" style="display:none">
          <div class="panel-section-label">📈 Resultados que debes destacar</div>
          <div class="panel-results" id="panel-results"></div>
        </div>

        <div id="panel-pyhydra-wrap" style="display:none">
          <div class="panel-section-label">⚙ Papel de pyhydra en el caso</div>
          <div class="panel-pyhydra" id="panel-pyhydra-role"></div>
          <div class="panel-pyhydra-modules" id="panel-pyhydra-modules"></div>
        </div>

        <div class="panel-divider"></div>

        <!-- Script speech -->
        <div>
          <div class="panel-section-label">🎙 Guion para leer</div>
          <div class="panel-script" id="panel-script"></div>
        </div>

        <!-- Bullets preview -->
        <div id="panel-bullets-wrap">
          <div class="panel-section-label">Puntos en pantalla</div>
          <ul class="panel-bullets" id="panel-bullets"></ul>
        </div>

        <div class="panel-divider"></div>

        <!-- Presenter notes (collapsible) -->
        <div>
          <button class="notes-toggle-btn" id="notes-toggle">📝 Notas y preguntas típicas del tribunal ▼</button>
          <div id="panel-notes-body">
            <div class="panel-notes" id="panel-notes"></div>
          </div>
        </div>

        <div class="panel-divider"></div>

        <div id="panel-links-wrap">
          <div class="panel-section-label">🔗 Fuentes y material relacionado</div>
          <div class="panel-links" id="panel-links"></div>
        </div>

        <div class="panel-divider"></div>

        <!-- Next slide preview -->
        <div class="panel-next" id="panel-next">
          <div class="panel-next-label">→ Siguiente slide</div>
          <div class="panel-next-title" id="panel-next-title">—</div>
          <div class="panel-next-block" id="panel-next-block"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar (hidden in projection mode) -->
  <div class="live-bottombar" id="live-bottombar">
    <button class="live-nav-btn" id="live-prev" disabled>← Anterior</button>
    <div aria-hidden="true" style="flex:1"></div>
    <span class="live-keys">← → Espacio · M: activar/salir de proyección · P: presentador · F: pantalla completa</span>
    <input class="live-go-input" id="live-go" type="number" min="1" max={totalSlides} value="1" title="Ir al slide" />
    <button class="live-nav-btn live-nav-next" id="live-next">Siguiente →</button>
  </div>
</div>

<!-- ========================================== -->
<!-- Dedicated Presenter Window HTML Layout     -->
<!-- (Only shown if ?presenter=1 URL query)    -->
<!-- ========================================== -->
<div id="presenter-only-layout" style="display:none;" class="presenter-window-layout">
  <!-- Left Side: Preview of current slide -->
  <div class="presenter-window-left">
    <div style="padding:16px 24px; border-bottom:1px solid rgba(255,255,255,0.06); display:flex; justify-content:space-between; align-items:center;">
      <span style="font-weight:800; color:#5eead4;">📺 VISTA DEL PROYECTOR (PREVIEW)</span>
      <span id="pres-win-counter" style="font-weight:700; color:#64748b;">1/29</span>
    </div>
    <div class="presenter-preview-frame">
      <!-- Read-only mirror of what the audience sees: pointer-events disabled so its own
           nav controls can't be clicked by mistake — this pane never drives shared state,
           only the buttons below do. -->
      <iframe id="pres-win-preview-iframe" style="width:100%; height:100%; border:none; background:#020617; pointer-events:none;" src={asset('/defensa-offline/?slide=0&preview=1')} tabindex="-1"></iframe>
    </div>
  </div>

  <!-- Right Side: Notes and large controls -->
  <div class="presenter-window-right">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <span class="panel-section-label">Tiempo transcurrido</span>
        <div class="presenter-large-timer" id="pres-win-timer">0:00</div>
      </div>
      <div style="text-align:right;">
        <span class="panel-section-label">Próximo bloque</span>
        <div id="pres-win-next-block" style="font-size:14px; font-weight:700; color:#a5b4fc;">—</div>
      </div>
    </div>

    <div class="panel-divider"></div>

    <!-- Speech text -->
    <div>
      <span class="panel-section-label">🎙 Lo que debes decir (Guion)</span>
      <div id="pres-win-speech" style="font-size:16px; line-height:1.6; color:#e2e8f0; font-style:italic; border-left:4px solid #0d9488; padding-left:16px; margin-top:6px;">—</div>
    </div>

    <!-- Notes & expected tribunal questions -->
    <div>
      <span class="panel-section-label" style="color:#38bdf8;">💡 Guía para el presentador y preguntas del tribunal</span>
      <div class="presenter-notes-area" id="pres-win-notes">—</div>
    </div>

    <div class="panel-divider"></div>

    <!-- Next slide Title -->
    <div class="panel-next">
      <span class="panel-next-label">Siguiente diapositiva</span>
      <div class="panel-next-title" id="pres-win-next-title">—</div>
    </div>

    <!-- Navigation Buttons -->
    <div style="display:flex; gap:16px; margin-top:auto;">
      <button class="live-nav-btn" id="pres-win-prev" style="flex:1; padding:12px; font-size:14px;">← Diapositiva anterior</button>
      <button class="live-nav-btn live-nav-next" id="pres-win-next" style="flex:1.5; padding:12px; font-size:14px;">Diapositiva siguiente →</button>
    </div>
  </div>
</div>

<script define:vars={{ base }}>
  window.__hydra_base = base;
</script>

<script>
  import { slides, totalSlides } from '../data/slides.ts';

  // ── Mode detection ──
  const params = new URLSearchParams(window.location.search);
  const isPresenterWindow = params.get('presenter') === '1';
  const base = (window as any).__hydra_base ?? '/';

  // Synchronizer BroadcastChannel for double-screen PPT-like view
  const syncChannel = new BroadcastChannel('defensa-sync');

  // Adjust DOM visible nodes immediately based on mode
  if (isPresenterWindow) {
    document.getElementById('live-shell')!.style.display = 'none';
    document.getElementById('presenter-only-layout')!.style.display = 'grid';
  }

  // ── State ──
  let current = -1;
  let elapsed = 0;
  const timerStartedAt = isPresenterWindow
    ? Number(localStorage.getItem('defensa-live-timer-start')) || Date.now()
    : Date.now();
  if (!isPresenterWindow) localStorage.setItem('defensa-live-timer-start', String(timerStartedAt));
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let panelOpen = false;
  let notesOpen = true;
  let projectionMode = false;

  // ── DOM References ──
  const iframe          = document.getElementById('live-iframe') as HTMLIFrameElement;
  const loading         = document.getElementById('iframe-loading')!;
  const iframeWrap      = document.getElementById('iframe-wrap')!;
  const slideWrap       = document.getElementById('slide-wrap')!;
  const slideContent     = document.getElementById('live-slide-content')!;
  const audienceSlideFrame = document.getElementById('audience-slide-frame') as HTMLIFrameElement;
  const panel           = document.getElementById('live-panel')!;
  const progress        = document.getElementById('live-progress')!;
  const counter         = document.getElementById('live-counter')!;
  const timerEl         = document.getElementById('live-timer')!;
  const topBlock        = document.getElementById('top-block')!;
  const modeBadge       = document.getElementById('live-mode-badge')!;
  const goInput         = document.getElementById('live-go') as HTMLInputElement;
  const prevBtn         = document.getElementById('live-prev') as HTMLButtonElement;
  const nextBtn         = document.getElementById('live-next') as HTMLButtonElement;
  const panelTitle      = document.getElementById('panel-title')!;
  const panelSubtitle   = document.getElementById('panel-subtitle')!;
  const panelObjective  = document.getElementById('panel-objective')!;
  const panelCue        = document.getElementById('panel-cue')!;
  const panelResults    = document.getElementById('panel-results')!;
  const panelResultsWrap = document.getElementById('panel-results-wrap')!;
  const panelPyhydraWrap = document.getElementById('panel-pyhydra-wrap')!;
  const panelPyhydraRole = document.getElementById('panel-pyhydra-role')!;
  const panelPyhydraModules = document.getElementById('panel-pyhydra-modules')!;
  const panelScriptEl   = document.getElementById('panel-script')!;
  const panelBullets    = document.getElementById('panel-bullets')!;
  const panelBulletsWrap = document.getElementById('panel-bullets-wrap')!;
  const panelNotes      = document.getElementById('panel-notes')!;
  const panelLinks      = document.getElementById('panel-links')!;
  const panelLinksWrap  = document.getElementById('panel-links-wrap')!;
  const panelNextTitle  = document.getElementById('panel-next-title')!;
  const panelNextBlock  = document.getElementById('panel-next-block')!;

  // Presenter Window Only elements
  const presWinTimer       = document.getElementById('pres-win-timer')!;
  const presWinNextBlock   = document.getElementById('pres-win-next-block')!;
  const presWinSpeech      = document.getElementById('pres-win-speech')!;
  const presWinNotes       = document.getElementById('pres-win-notes')!;
  const presWinNextTitle   = document.getElementById('pres-win-next-title')!;
  const presWinCounter     = document.getElementById('pres-win-counter')!;
  const presWinPrevBtn     = document.getElementById('pres-win-prev') as HTMLButtonElement;
  const presWinNextBtn     = document.getElementById('pres-win-next') as HTMLButtonElement;
  const presPreviewIframe  = document.getElementById('pres-win-preview-iframe') as HTMLIFrameElement;

  // Render the same 1920 × 1080 canvas on both screens, scaling the whole
  // iframe rather than reflowing projection typography into a small preview.
  for (const frame of [audienceSlideFrame, presPreviewIframe]) {
    const container = frame.parentElement!;
    const fitFrame = () => {
      const { width, height } = container.getBoundingClientRect();
      if (!width || !height) return;
      const scale = Math.min(container.clientWidth / 1920, container.clientHeight / 1080);
      Object.assign(frame.style, {
        position: 'absolute', width: '1920px', height: '1080px',
        left: `${(container.clientWidth - 1920 * scale) / 2}px`,
        top: `${(container.clientHeight - 1080 * scale) / 2}px`,
        transformOrigin: 'top left', transform: `scale(${scale})`,
      });
    };
    new ResizeObserver(fitFrame).observe(container);
    fitFrame();
  }

  type PresenterLink = { label: string; href: string };
  const localHref = (path: string) => `${base.replace(/\/$/, '')}${path}`;
  function presenterLinksFor(slide: typeof slides[0]): PresenterLink[] {
    const links: PresenterLink[] = [];
    if (slide.url) links.push({ label: slide.webLabel ?? 'Abrir la página mostrada', href: localHref(slide.url) });
    if (slide.figure) links.push({ label: `Abrir figura · ${slide.figureCaption ?? slide.figure}`, href: localHref(`/defensa/figures/${slide.figure}`) });

    if (slide.title.includes('Fuentes de datos')) links.push({ label: 'Módulo HYDRA · Fuentes de datos', href: localHref('/modules/fuentes-datos') });
    else if (/GEV|Cópulas|estocástica|climátic/i.test(slide.title) && ['Bloque climático-estadístico','Módulos'].includes(slide.block)) links.push({ label: 'Módulo HYDRA · Análisis climático', href: localHref('/modules/analisis-climatico') });
    else if (/Modelización|Modelos hidrológicos|acoplamiento/i.test(slide.title)) links.push({ label: 'Módulo HYDRA · Modelización', href: localHref('/modules/modelizacion') });

    const caseRoutes: Array<[RegExp,string,string]> = [
      [/Besaya/i,'Caso reproducible · Besaya','/cases/los-corrales-buelna'],
      [/Mallorca/i,'Caso reproducible · Mallorca','/cases/mallorca-sant-llorenc'],
      [/Calle 30/i,'Caso reproducible · Calle 30','/cases/m30-manzanares'],
      [/Valencia/i,'Caso reproducible · DANA Valencia','/cases/valencia-dana'],
      [/Tanganica/i,'Caso reproducible · Lago Tanganica','/cases/lago-tanganica'],
      [/Andes/i,'Caso reproducible · Andes','/cases/andes-hidroelectrico'],
      [/Panamá/i,'Caso reproducible · Atlas de Panamá','/cases/atlas-panama'],
      [/SIMPCCe/i,'Caso reproducible · SIMPCCe','/cases/simpcce'],
    ];
    const caseRoute = caseRoutes.find(([pattern]) => pattern.test(slide.title));
    if (caseRoute) links.push({ label: caseRoute[1], href: localHref(caseRoute[2]) });

    if (['Apertura','Arquitectura','Validación','Conclusiones','Cierre'].includes(slide.block)) {
      links.push({ label: 'Código fuente · pyhydra', href: 'https://github.com/navass11/pyhydra' });
    }
    if (['Arquitectura','Validación','Conclusiones','Cierre'].includes(slide.block)) {
      links.push({ label: 'Archivo reproducible · Zenodo', href: 'https://doi.org/10.5281/zenodo.20932555' });
    }
    return links.filter((link, index, all) => all.findIndex(other => other.href === link.href) === index).slice(0, 4);
  }
  function presenterObjectiveFor(slide: typeof slides[0]): string {
    if (slide.id === 1) return 'Presentar formalmente la tesis, la autoría y el marco institucional.';
    if (slide.webPurpose) return slide.webPurpose;
    const byBlock: Record<string,string> = {
      'Apertura':'Fijar el marco conceptual y el recorrido de la defensa.',
      'Motivación':'Justificar el problema científico y formular la hipótesis.',
      'Estado del arte':'Delimitar la brecha que HYDRA resuelve.',
      'Arquitectura':'Explicar cómo se convierte la metodología en infraestructura reproducible.',
      'Bloque de datos':'Mostrar qué fuentes entran en la cadena y cómo se normalizan.',
      'Bloque climático-estadístico':'Explicar cómo se caracterizan extremos, dependencias y escenarios.',
      'Bloque de modelización':'Mostrar cómo se conectan los motores físicos y sus salidas.',
      'Módulos':'Mostrar la función verificable de este componente dentro de la cadena.',
      'Demo en vivo':'Demostrar la operación real del núcleo científico.',
      'Casos de estudio':'Aportar evidencia empírica y transferencia industrial.',
      'Validación':'Relacionar hipótesis, resultados y veredicto.',
      'Conclusiones':'Distinguir aportaciones, límites y trabajo futuro.',
      'Cierre':'Cerrar con la contribución original y su transferibilidad.',
    };
    return byBlock[slide.block] ?? `Explicar la función de esta diapositiva dentro de ${slide.block}.`;
  }
  function presenterCueFor(slide: typeof slides[0]): string {
    if (slide.id === 1) return 'Saludar al tribunal, hacer una pausa y nombrar director y tutor sin leer la portada.';
    if (slide.webAction) return slide.webAction;
    if (slide.figureCaption) return `Señalar en la figura: ${slide.figureCaption}`;
    const firstNote = slide.notes?.split(/\n|(?<=[.!?])\s/).find(part => part.trim().length > 12)?.trim();
    return firstNote ?? 'Conectar el mensaje con la diapositiva anterior y anticipar la siguiente.';
  }

  // ── Timer ──
  function startTimer() {
    if (timerInterval) return;
    timerInterval = setInterval(() => {
      elapsed = Math.floor((Date.now() - timerStartedAt) / 1000);
      const m = Math.floor(elapsed / 60);
      const s = elapsed % 60;
      const timeStr = `⏱ ${m}:${s.toString().padStart(2,'0')}`;
      const timeStrLarge = `${m}:${s.toString().padStart(2,'0')}`;
      if (timerEl) timerEl.textContent = timeStr;
      if (presWinTimer) presWinTimer.textContent = timeStrLarge;
    }, 1000);
  }

  // ── Sync Channel communication ──
  function broadcastChange(index: number) {
    syncChannel.postMessage({ type: 'slide-change', index });
  }

  syncChannel.onmessage = (e) => {
    if (e.data && e.data.type === 'slide-change') {
      goTo(e.data.index);
    }
  };

  // Storage event listener fallback (very reliable for popups and multiple tabs)
  window.addEventListener('storage', (e) => {
    if (e.key === 'defensa-live-slide' && e.newValue !== null) {
      const idx = parseInt(e.newValue);
      if (idx !== current) {
        goTo(idx);
      }
    }
  });

  // ── Iframe URL builder ──
  function buildUrl(slide: typeof slides[0]): string | null {
    // Only change the projector to the website at deliberately scripted evidence/demo moments.
    // Other URLs remain available as presenter references without interrupting the oral narrative.
    if (!slide.url || !slide.webMode) return null;
    return base.replace(/\/$/, '') + slide.url;
  }

  // ── Navigate Iframe ──
  let iframeCurrentPath = '';
  let loadingSlowTimer: ReturnType<typeof setTimeout> | null = null;
  const loadingText = document.getElementById('iframe-loading-text');

  function navigateIframe(slide: typeof slides[0]) {
    const url = buildUrl(slide);
    if (!url) return;

    const targetPath = new URL(url, window.location.origin).pathname;
    if (iframeCurrentPath !== targetPath) {
      if (loading) loading.classList.add('visible');
      if (loadingText) loadingText.textContent = 'Cargando HYDRA…';
      if (loadingSlowTimer) clearTimeout(loadingSlowTimer);
      loadingSlowTimer = setTimeout(() => {
        if (loadingText) loadingText.textContent = 'Sigue cargando… la conexión va más lenta de lo normal';
      }, 4000);
      iframe.src = url;
      iframeCurrentPath = targetPath;
    } else {
      sendToIframe(slide);
    }
  }

  // ── Send commands to pages inside Iframe ──
  function sendToIframe(slide: typeof slides[0]) {
    try {
      iframe.contentWindow?.postMessage({
        type: 'defensa-command',
        anchor: slide.anchor ?? null,
        highlight: slide.highlight ?? null,
      }, '*');
    } catch (_) {}
  }

  if (iframe) {
    iframe.addEventListener('load', () => {
      if (loading) loading.classList.remove('visible');
      if (loadingSlowTimer) { clearTimeout(loadingSlowTimer); loadingSlowTimer = null; }
      try {
        iframeCurrentPath = new URL(iframe.src).pathname;
      } catch (_) {}
      setTimeout(() => sendToIframe(slides[current]), 600);
    });
  }

  audienceSlideFrame.addEventListener('load', () => {
    audienceSlideFrame.contentWindow?.postMessage({ type: 'defensa-preview-slide', index: Math.max(0, current) }, '*');
  });

  // ── Toggle Presentation View Layouts ──
  function setProjectionMode(val: boolean) {
    projectionMode = val;
    const body = document.body;
    body.classList.toggle('projection-view', val);
    
    // Auto-minimize sidebar panel state
    if (val) {
      panel.classList.add('collapsed');
      const projectionButton = document.getElementById('btn-projection')!;
      projectionButton.textContent = '📺 Salir de proyección (M)';
      projectionButton.setAttribute('aria-label', 'Salir del modo proyección');
      projectionButton.setAttribute('aria-pressed', 'true');
    } else {
      if (panelOpen) panel.classList.remove('collapsed');
      const projectionButton = document.getElementById('btn-projection')!;
      projectionButton.textContent = '📺 Proyectar (M)';
      projectionButton.setAttribute('aria-label', 'Activar modo proyección');
      projectionButton.setAttribute('aria-pressed', 'false');
    }
  }

  // ── Dynamic Slide HTML Renderer (Same design as offline) ──
  function renderSlideContent(slide: typeof slides[0]) {
    if (isPresenterWindow) return; // Presenter window does not render slides locally
    const figSrc = slide.figure ? `${base.replace(/\/$/, '')}/defensa/figures/${slide.figure}` : null;
    const secondaryFigSrc = slide.secondaryFigure ? `${base.replace(/\/$/, '')}/defensa/figures/${slide.secondaryFigure}` : null;
    let html = '';

    const headerStyle = `margin-bottom:16px; animation:fadeInDown 0.5s ease both;`;
    const titleStyle = `font-size:clamp(26px, 3.4vw, 44px); font-weight:800; color:#f1f5f9; letter-spacing:-0.02em; line-height:1.2; margin-bottom:8px;`;
    const subtitleStyle = `font-size:clamp(17px, 1.9vw, 22px); color:#94a3b8; font-style:italic;`;
    const scriptStyle = `font-size:clamp(15px, 1.4vw, 17px); line-height:1.55; color:#9aa5b5; border-left:3px solid ${slide.blockColor}; padding-left:16px; margin-bottom:16px; font-style:italic; animation:fadeInLeft 0.5s ease both;`;
    const bulletLiStyle = `font-size:clamp(17px, 1.9vw, 21px); color:#d5dbe5; padding:10px 14px; border-radius:8px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); line-height:1.4; transform: translateY(10px); opacity:0; transition: all 0.3s ease;`;

    // Render Cover Page
    if (slide.type === 'title') {
      const isFirst = slide.id === 1;
      html += `
